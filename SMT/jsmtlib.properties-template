# This file is a template - it lists all the properties that the jSMTLIB
# application pays attention to. You should customize the values for your
# own system.
#
# jSMTLIB looks for a file named jsmtlib.properties in four places, loading
# each one found on top of the last -- so later sources override earlier
# ones for any key both define, and the last one loaded wins overall:
#   1. As a classpath resource (e.g. bundled inside jSMTLIB.jar itself)
#   2. In the directory containing jSMTLIB.jar, if running from a jar
#   3. In the user's home directory
#   4. In the current working directory  <- highest precedence
# In practice this means a jsmtlib.properties file in your working directory
# overrides everything else, which is the usual way to customize a checkout.

# The directory in which logic and theory definitions are found
# (if not set, the files from the official distribution as distributed in
#  the .jar file are used - there should be only a rare need to set this)
# This value can also be set on the command-line by the --logics option.
org.smtlib.logic_path=

# The default solver to use. This can be overridden on the command-line with
# the --solver option. If not set the default is to type-check only.
##org.smtlib.default-solver=

# The adapter class to use for the solver. If not specified, then solver ZZZ
# will use class org.smtlib.solvers.Solver_ZZZ (with any '-' or '.' in ZZZ
# replaced by '_'), and if that class does not exist, the solver falls back
# to the generic SMT-LIB-text adapter, org.smtlib.solvers.Solver_smt.
# (Replace ZZZ with the solver name)
##org.smtlib.solver_ZZZ.adapter=

# A solver must have either an executable or a whole command-line specified.
# The absolute path to the executable for each solver. This value is
# overridden by any value specified on the command-line (--exec option). A
# relative path is resolved against the SMT_SOLVER_DIR environment variable
# if that's set, and left as-is (so the OS searches PATH) otherwise.
##org.smtlib.solver_ZZZ.exec=

# A command (executable + arguments) is specified by a comma-separated list
# of executable path and arguments, with no extraneous spaces, in the form
##org.smtlib.solver_ZZZ.command=EXE,arg1,arg2

# Either .adapter or .exec above can be overridden per-platform by appending
# .windows, .macos, or .linux (matching SMT.platformName()) -- checked before
# the bare, non-platform-specific property, for solvers whose executable
# filename or behavior genuinely differs by platform. .command has no
# platform-specific form. For example, z3-4.3 ships as z3-4.3.1 on Unix/macOS
# but z3-4.3.2 on Windows, and that Windows build has its own push-command
# bug needing a different adapter class:
##org.smtlib.solver_z3-4.3.exec=z3-4.3.1
##org.smtlib.solver_z3-4.3.exec.windows=z3-4.3.2
##org.smtlib.solver_z3-4.3.adapter.windows=org.smtlib.solvers.Solver_z3_4_3_2

# Real adapter classes exist for these solver families: yices2 (Solver_yices2),
# cvc5 (Solver_cvc5), smtinterpol (Solver_smtinterpol), simplify
# (Solver_simplify, legacy), and z3 (several version-specific adapters --
# Solver_z3_recent covers current z3 releases). A solver name with no
# matching adapter class and no .adapter override still works, using the
# generic Solver_smt text-protocol adapter, but won't get that solver's
# version-specific quirk handling. A few illustrative examples:
##org.smtlib.solver_yices2-2.7.0.adapter=org.smtlib.solvers.Solver_yices2
##org.smtlib.solver_yices2-2.7.0.exec=yices2-2.7.0
##org.smtlib.solver_cvc5-1.3.2.adapter=org.smtlib.solvers.Solver_cvc5
##org.smtlib.solver_cvc5-1.3.2.exec=cvc5-1.3.2
##org.smtlib.solver_z3-4.16.0.adapter=org.smtlib.solvers.Solver_z3_recent
##org.smtlib.solver_z3-4.16.0.exec=z3-4.16.0
