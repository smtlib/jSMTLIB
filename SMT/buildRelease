#! /bin/bash
set -e

## Set JAVA_HOME only if not already set in the environment (e.g. by CI setup-java)
if [ -z "$JAVA_HOME" ] && command -v /usr/libexec/java_home > /dev/null 2>&1; then
  export JAVA_HOME=$(/usr/libexec/java_home)
fi
[ -z "$JAVA_HOME" ] && { echo "ERROR: JAVA_HOME is not set and /usr/libexec/java_home is not available"; exit 1; }

version=$(cat version.txt)
echo Building version $version
sed -e "s/DEV/${version}/" src/org/smtlib/resources/version.template > src/org/smtlib/resources/version.properties

rm -rf temp
mkdir temp

echo Compiling sources
mkdir -p bin
find src -name "*.java" > temp/sources.txt
"$JAVA_HOME/bin/javac" -d bin @temp/sources.txt
mkdir -p bin/org/smtlib/resources
cp src/org/smtlib/resources/version.properties bin/org/smtlib/resources/version.properties
cp logics/*.smt2 bin/
echo "Manifest-Version: 1.0" > temp/manifest
echo "Main-Class: org.smtlib.SMT" >> temp/manifest
cd bin || { echo "Cannot cd to bin"; exit 1; }
rm -f jsmtlib.properties
cp ../jsmtlib.properties .
"$JAVA_HOME/bin/jar" -cfm ../jSMTLIB.jar ../temp/manifest .
cd ..
