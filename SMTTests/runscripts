#!/bin/bash

cd "$(dirname "$0")" || exit 1
trap 'exit 130' INT
if [ -n "${COV++}" ]; then
    source ./setup-coverage scripts
fi
source setup

if [ $# -eq 0 ]; then
    # Recurse (e.g. into scripts/solverBehavior/), not just the top level.
    files=()
    while IFS= read -r -d '' f; do files+=( "$f" ); done < <(find "$SCRIPTS" -name '*.scr' -print0 | sort -z)
else
    files=()
    for arg in "$@"; do
        if [[ "$arg" != */* ]]; then
            files+=( "$SCRIPTS/$arg" )
        else
            files+=( "$arg" )
        fi
    done
fi
fail=0
for f in "${files[@]}" ; do
    if [ ! -e "$f" ] && [ -e "$f.scr" ]; then
        f="$f.scr"
    fi
    if [ ! -e "$f" ]; then
        echo "SKIP $f: file not found"
        continue
    fi
    echo SCRIPT $f
    ### runscript does the checking, as for ScriptTests
    bash ./runscript "$f"
    ret=$?
    if [ $ret -ne 0 ] && [ $ret -ne 77 ]; then (( fail++ )); fi
done
if [ $fail -eq 0 ]; then
    echo "All script tests SUCCEEDED"
else
    echo "$fail script test FAILURES"
fi
[ $fail -gt 0 ] && exit 1
exit 0
