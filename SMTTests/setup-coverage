## Sets up JaCoCo coverage when COV is set (to any value, including empty).
## Must be sourced, not executed.
## Usage: source setup-coverage <rootname>
##   <rootname> is the base name for the .exec output file (e.g. "smt")

if [ "$0" = "$BASH_SOURCE" ]; then
    echo "Error: setup-coverage must be sourced, not executed"
    exit 1
fi
if [ -z "$1" ]; then
    echo "setup-coverage requires one argument (output file rootname)"
    exit 1
fi

FILE=$(realpath "$BASH_SOURCE")
TEST=$(dirname "$FILE")

export COV_AGENT=

if [ -n "${COV++}" ]; then
    mkdir -p "$TEST/cov"
    AGENT_JAR="$TEST/jacoco/lib/jacocoagent.jar"
    DEST_FILE="$TEST/cov/$1.exec"
    ## -javaagent: is parsed by the native JVM launcher itself, not by bash, so it needs a
    ## Windows-form path there -- same reason ./setup cygpath-converts SMT_JAR/COV_CLASSES.
    ## Can't reuse ./setup's own $PLATFORM for this, though: runjunits deliberately sources
    ## setup-coverage BEFORE setup (so COV_AGENT already has a value when setup builds
    ## SMT_CMD/SMT_DRIVER), which means $PLATFORM isn't set yet at this point -- hence the
    ## separate uname check here, duplicating setup's own platform-detection idiom instead
    ## of depending on its output order. Confirmed via CI (run 35530298789) that skipping
    ## this conversion doesn't error, doesn't hang, and doesn't fail any test -- the agent
    ## just silently never attaches, so cov/junits.exec never gets written at all, only
    ## caught in a rerun by cov-report's zero-length-file failure afterward, not by
    ## anything at the point coverage was actually being collected. destfile= needs the
    ## same conversion as the leading jar path -- it's a raw path string parsed by the
    ## agent itself at runtime, not something the JVM launcher resolves either way.
    case "$(uname -s | tr '[:upper:]' '[:lower:]')" in
        mingw*|msys*|cygwin*)
            AGENT_JAR=$(cygpath -w "$AGENT_JAR")
            DEST_FILE=$(cygpath -w "$DEST_FILE")
            ;;
    esac
    export COV_AGENT="-javaagent:${AGENT_JAR}=destfile=${DEST_FILE}"

    ## Per-test mode (make cov-test-by-test sets COV_BY_TEST): instead of one destfile for
    ## the whole run, each test's coverage goes to its own cov/by-test/<test>.exec (see
    ## PerTestCoverageListener.java). Two different agent strings are needed:
    ##  - COV_MAIN_AGENT, for runjunits' own JVM: its destfile only ever receives what runs
    ##    OUTSIDE any test (class init, @Parameters, @BeforeClass) -- the listener reads out
    ##    and resets each test's own counters itself, through JaCoCo's runtime API.
    ##  - COV_AGENT, for child JVMs (setup bakes it into SMT_CMD/SMT_DRIVER): its destfile
    ##    holds a literal @COV_TEST@ placeholder, which runscript replaces with the current
    ##    test's file stem (read from cov/by-test/.current-test, written by the listener),
    ##    so a child JVM's coverage lands in the file of the test that spawned it (and its
    ##    JaCoCo session is named after that test, like the main JVM's own session).
    if [ -n "${COV_BY_TEST++}" ]; then
        BY_TEST_DIR="$TEST/cov/by-test"
        mkdir -p "$BY_TEST_DIR"
        case "$(uname -s | tr '[:upper:]' '[:lower:]')" in
            mingw*|msys*|cygwin*) BY_TEST_DIR=$(cygpath -w "$BY_TEST_DIR") ;;
        esac
        export COV_BY_TEST_DIR="$BY_TEST_DIR"
        export COV_MAIN_AGENT="-javaagent:${AGENT_JAR}=destfile=${BY_TEST_DIR}/_outside-tests.exec"
        export COV_AGENT="-javaagent:${AGENT_JAR}=destfile=${BY_TEST_DIR}/@COV_TEST@.exec,sessionid=@COV_TEST@"
    fi
fi
