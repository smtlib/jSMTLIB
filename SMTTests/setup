SMT_DIR=$(cd ../SMT && pwd)
export SMT_DIR
export SMT_JAR=$SMT_DIR/jSMTLIB.jar
export TESTS=$(cd tests && pwd)
export SCRIPTS=$(cd scripts && pwd)

# Normalized platform name used to select platform-specific golden files
_p=$(uname -s | tr '[:upper:]' '[:lower:]')
case "$_p" in
  darwin*)               PLATFORM=macos ;;
  linux*)                PLATFORM=linux ;;
  mingw*|msys*|cygwin*)  PLATFORM=windows ;;
  *)                     PLATFORM="$_p" ;;
esac
export PLATFORM

# Architecture suffix for finer-grained platform discrimination (e.g. linux-arm64)
_a=$(uname -m)
case "$_a" in
  x86_64|amd64|i686) ARCH=x64 ;;
  arm64|aarch64)      ARCH=arm64 ;;
  *)                  ARCH="$_a" ;;
esac
export ARCH
export PLATFORM_ARCH="$PLATFORM-$ARCH"

# z3-4.12.6, yices2-2.6.5, and yices2-2.7.0 (including the bare "yices2" name, which
# resolves to yices2-2.7.0 on non-Windows per jsmtlib.properties) were never built/
# uploaded for Linux ARM64 in OpenJML/Solvers (confirmed via CI: every other same-family
# solver version is present and working on this platform, but these fail to launch at
# all with "No such file or directory"). Filtered out of whatever SMT_TEST_SOLVERS
# already resolved to -- whether that's the Makefile's own default or an explicit
# override -- rather than left to fail per-test across the whole suite, since jSMTLIB has
# no way to distinguish "doesn't exist yet for this platform" from "actually broken"
# without this. Applies equally to a local ARM64 Linux dev machine, not just CI. Revisit
# once OpenJML/Solvers ships arm64 builds for these.
if [[ "$PLATFORM_ARCH" == "linux-arm64" && -n "${SMT_TEST_SOLVERS:-}" ]]; then
    SMT_TEST_SOLVERS=$(echo "$SMT_TEST_SOLVERS" | tr ' ' '\n' | grep -vE '^(z3-4\.12\.6|yices2|yices2-2\.6\.5|yices2-2\.7\.0)$' | tr '\n' ' ' | sed 's/ *$//')
    export SMT_TEST_SOLVERS
fi

# Separator for multi-component paths passed to jSMTLIB's -L/--logics option (e.g.
# "scripts:../SMT/logics"), matching Java's own File.pathSeparator: ';' on Windows
# (even under Git Bash), ':' everywhere else. A .scr script hardcoding ':' breaks on
# Windows -- the whole string becomes one bogus, nonexistent path component instead of
# two real ones, since Utils.java's openLogicStream() already correctly splits on
# File.pathSeparator, not a hardcoded ':'.
if [[ "$PLATFORM" == "windows" ]]; then
    PATHSEP=";"
else
    PATHSEP=":"
fi
export PATHSEP

# Directory containing the solver executables for this platform.
# Relative names in jsmtlib.properties (e.g. z3-4.3.1) are resolved against this directory.
# Set SMT_SOLVER_DIR externally to override; the Makefile exports it before running tests.
if [[ -z "${SMT_SOLVER_DIR:-}" ]]; then
  case "$PLATFORM_ARCH" in
    macos-x64)    _SUBDIR=Solvers-macos ;;
    macos-arm64)  _SUBDIR=Solvers-macos-arm64 ;;
    linux-x64)    _SUBDIR=Solvers-linux ;;
    linux-arm64)  _SUBDIR=Solvers-linux-arm64 ;;
    windows-*)    _SUBDIR=Solvers-windows ;;
    *)            _SUBDIR=Solvers-$PLATFORM ;;
  esac
  SMT_SOLVER_DIR=../../OpenJML21/Solvers/$_SUBDIR
fi
export SMT_SOLVER_DIR

# Resolve COV_CLASSES to an absolute path — scripts that cd to a temp dir would break otherwise.
if [[ -n "${COV_CLASSES:-}" && "${COV_CLASSES}" != /* ]]; then
    COV_CLASSES="$(pwd)/${COV_CLASSES}"
fi

# Use -cp (not -jar) to allow coverage instrumentation (COV_CLASSES) to be prepended.
# jsmtlib.properties is embedded in the jar and loaded via ClassLoader.getSystemResource.
# On Windows, Java requires ; as the classpath separator and Windows-style paths;
# cygpath (bundled with Git for Windows) converts POSIX paths to Windows form.
if [[ "$PLATFORM" == "windows" ]]; then
    _w_jar=$(cygpath -w "$SMT_JAR")
    _w_classes=${COV_CLASSES:+$(cygpath -w "$COV_CLASSES")}
    export SMT_CMD="java ${COV_AGENT:-} -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8 -cp ${_w_classes:-$_w_jar} org.smtlib.SMT"
    export SMT_DRIVER="java ${COV_AGENT:-} -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8 -cp ${_w_classes:-$_w_jar} org.smtlib.Driver"
else
    export SMT_CMD="java ${COV_AGENT:-} -cp ${COV_CLASSES:-$SMT_JAR} org.smtlib.SMT"
    export SMT_DRIVER="java ${COV_AGENT:-} -cp ${COV_CLASSES:-$SMT_JAR} org.smtlib.Driver"
fi
