SMT_DIR=$(cd ../SMT && pwd)
export SMT_JAR=$SMT_DIR/jSMTLIB.jar
export TESTS=$(cd tests && pwd)
export SCRIPTS=$(cd scripts && pwd)
# Platform-specific directory containing solver executables (z3-4.3.1, cvc5-1.6, etc.).
# Must be set externally; the Makefile local-setup target reads jsmtlib.properties to discover it.
export SOLVERS=${SOLVERS:-}

# Normalized platform name used to select platform-specific golden files
_p=$(uname -s | tr '[:upper:]' '[:lower:]')
case "$_p" in
  darwin*)              PLATFORM=macos ;;
  linux*)               PLATFORM=linux ;;
  mingw*|msys*|cygwin*) PLATFORM=windows ;;
  *)                    PLATFORM="$_p" ;;
esac
export PLATFORM

# Architecture suffix for finer-grained platform discrimination (e.g. linux-arm64)
_a=$(uname -m)
case "$_a" in
  x86_64|amd64|i686) ARCH=x64 ;;
  arm64|aarch64)      ARCH=arm64 ;;
  *)                  ARCH="$_a" ;;
esac
export ARCH
export PLATFORM_ARCH="$PLATFORM-$ARCH"

# Resolve COV_CLASSES to an absolute path — scripts that cd to a temp dir would break otherwise.
if [[ -n "${COV_CLASSES:-}" && "${COV_CLASSES}" != /* ]]; then
    COV_CLASSES="$(pwd)/${COV_CLASSES}"
fi

# Use -cp (not -jar) so that SMT_DIR is on the classpath and jsmtlib.properties is found there.
# On Windows, Java requires ; as the classpath separator and Windows-style paths;
# cygpath (bundled with Git for Windows) converts POSIX paths to Windows form.
if [[ "$PLATFORM" == "windows" ]]; then
    _w_jar=$(cygpath -w "$SMT_JAR")
    _w_dir=$(cygpath -w "$SMT_DIR")
    _w_classes=${COV_CLASSES:+$(cygpath -w "$COV_CLASSES")}
    export SMT_CMD="java ${COV_AGENT:-} -cp ${_w_classes:-$_w_jar};${_w_dir} org.smtlib.SMT"
    export SMT_DRIVER="java ${COV_AGENT:-} -cp ${_w_classes:-$_w_jar} org.smtlib.Driver"
else
    export SMT_CMD="java ${COV_AGENT:-} -cp ${COV_CLASSES:-$SMT_JAR}:$SMT_DIR org.smtlib.SMT"
    export SMT_DRIVER="java ${COV_AGENT:-} -cp ${COV_CLASSES:-$SMT_JAR} org.smtlib.Driver"
fi
