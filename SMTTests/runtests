#! /bin/bash

cd "$(dirname "$0")" || exit 1
trap 'exit 130' INT
if [ -n "${COV++}" ]; then
    source ./setup-coverage smt
fi
source setup
rm -f tempout

# SMT_TEST_SOLVERS is the one controlling place for the solver list (default "test");
# --solvers below overrides it explicitly for this run. "z3-4.3" resolves to z3-4.3.1 on
# Unix/macOS and z3-4.3.2.exe on Windows -- see the platform-suffixed
# org.smtlib.solver_z3-4.3.exec.windows / .adapter.windows properties in jsmtlib.properties,
# which account for the Windows build's own behavioral differences (e.g. its push-command
# bug), so no special handling is needed here.
solvers="${SMT_TEST_SOLVERS:-test}"

while [[ $# -gt 0 && "$1" == --* ]]; do
    case "$1" in
        --solvers) solvers="$2"; shift 2 ;;
        *) echo "Unknown option: $1" >&2; exit 1 ;;
    esac
done

if [ $# -eq 0 ]; then
    tests=( $(find "$TESTS" -name "*.tst" | sort) )
else
    tests=()
    for arg in "$@"; do
        if [[ "$arg" != */* ]]; then
            found=$(find "$TESTS" \( -name "$arg" -o -name "$arg.tst" \) | head -1)
            tests+=( "${found:-$TESTS/$arg}" )
        else
            tests+=( "$arg" )
        fi
    done
fi

echo SOLVERS $solvers

count=0
ok=0
skip=0
for f in "${tests[@]}" ; do
    for solver in $solvers; do
        (( count++ ))
        ./runtest $solver "$f"
        ret=$?
        if   [ $ret == 0  ]; then (( ok++ ))
        elif [ $ret == 77 ]; then (( skip++ ))
        fi
    done
done
(( fail = count - ok - skip ))
if [ $fail == 0 ]; then
    echo "All $((count - skip)) tests SUCCEEDED${skip:+, $skip skipped}"
else
    echo "$fail FAILURES out of $((count - skip)) tests${skip:+, $skip skipped}"
fi
source version.check
vercheck=$?
[ $fail -gt 0 ] || [ $vercheck -ne 0 ] && exit 1
exit 0
