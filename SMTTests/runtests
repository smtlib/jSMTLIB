#! /bin/bash

cd "$(dirname "$0")" || exit 1
trap 'exit 130' INT
if [ -n "${COV++}" ]; then
    source ./setup-coverage smt
fi
source setup
rm -f tempout

# Windows ships z3-4.3.2.exe (not 4.3.1), which differs in error messages, version
# strings, and other behaviors; skip z3_4_3 there and test only the built-in solver.
if [[ "$PLATFORM" == "windows" ]]; then
    solvers="test"
else
    solvers="test z3_4_3"
fi

while [[ $# -gt 0 && "$1" == --* ]]; do
    case "$1" in
        --solvers) solvers="$2"; shift 2 ;;
        *) echo "Unknown option: $1" >&2; exit 1 ;;
    esac
done

if [ $# -eq 0 ]; then
    tests=( $(find "$TESTS" -name "*.tst" | sort) )
else
    tests=()
    for arg in "$@"; do
        if [[ "$arg" != */* ]]; then
            found=$(find "$TESTS" \( -name "$arg" -o -name "$arg.tst" \) | head -1)
            tests+=( "${found:-$TESTS/$arg}" )
        else
            tests+=( "$arg" )
        fi
    done
fi

echo SOLVERS $solvers

count=0
ok=0
skip=0
for f in "${tests[@]}" ; do
    for solver in $solvers; do
        (( count++ ))
        ./runtest $solver "$f"
        ret=$?
        if   [ $ret == 0  ]; then (( ok++ ))
        elif [ $ret == 77 ]; then (( skip++ ))
        fi
    done
done
(( fail = count - ok - skip ))
if [ $fail == 0 ]; then
    echo "All $((count - skip)) tests SUCCEEDED${skip:+, $skip skipped}"
else
    echo "$fail FAILURES out of $((count - skip)) tests${skip:+, $skip skipped}"
fi
source version.check
vercheck=$?
[ $fail -gt 0 ] || [ $vercheck -ne 0 ] && exit 1
exit 0
