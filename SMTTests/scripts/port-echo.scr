##EXITCODE 0

PORT=8777

EXE="$SMT_DRIVER --port ${PORT}"

$SMT_CMD --port ${PORT} --echo &
SERVER_PID=$!
trap 'kill $SERVER_PID 2>/dev/null; wait $SERVER_PID 2>/dev/null' EXIT
sleep 1

${EXE} "(set-logic QF_UF)"
echo EX $?

${EXE} "(declare-fun x () Bool)"
echo EX $?

${EXE} "(xxx)"
echo EX $?

${EXE} "(declare-fun y () Bool)"
echo EX $?

${EXE} "(exit)"
echo EX $?




