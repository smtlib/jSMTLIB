##EXITCODE 0
# cvc5's (get-info :all-statistics) response embeds non-deterministic timing
# values (e.g. "1026ms") scattered throughout the structure, so it cannot be
# matched against a fixed golden the way tests/getInfo/err_getInfo2_allStatistics.tst
# does for z3 (whose response is stable apart from a single :memory line already
# handled by runtest's -I '[(]:memory' ignore). Instead, check here that the
# command is actually supported (not "unsupported") and that the response is a
# well-formed, balanced S-expression starting with ":all-statistics" -- without
# requiring exact content, which would vary between runs.

PASS=0
FAIL=0

pass() { echo "PASS: $1"; PASS=$((PASS + 1)); }
fail() { echo "FAIL: $1"; FAIL=$((FAIL + 1)); if [ -n "$2" ]; then echo "  $2"; fi; }

CVC5="$SMT_SOLVER_DIR/cvc5-1.3.2"
if [ ! -x "$CVC5" ]; then
    echo "SKIP: cvc5-1.3.2 not found at $CVC5"
    exit 77
fi

out=$(printf '%s\n' '(set-logic QF_UF)' '(get-info :all-statistics)' | \
    "$CVC5" --lang smt --interactive --incremental --quiet --print-success --strict-parsing 2>&1)

response=$(printf '%s\n' "$out" | tail -n +2)

if [ "$response" = "unsupported" ]; then
    fail "get-info :all-statistics is supported" "cvc5 returned: unsupported"
else
    pass "get-info :all-statistics is supported"
fi

case "$response" in
    "(:all-statistics"*)
        pass "response starts with (:all-statistics"
        ;;
    *)
        fail "response starts with (:all-statistics" "got: $response"
        ;;
esac

opens=$(printf '%s' "$response" | tr -cd '(' | wc -c)
closes=$(printf '%s' "$response" | tr -cd ')' | wc -c)
if [ "$opens" -gt 0 ] && [ "$opens" -eq "$closes" ]; then
    pass "response has balanced parentheses"
else
    fail "response has balanced parentheses" "got $opens open, $closes close"
fi

echo ""
if [ $FAIL -eq 0 ]; then
    echo "All $PASS all-statistics checks PASSED"
    exit 0
else
    echo "$FAIL FAILURES, $PASS passed"
    exit 1
fi
