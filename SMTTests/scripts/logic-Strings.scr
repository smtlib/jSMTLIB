##EXITCODE 1
$SMT_CMD -L scripts:../SMT/logics --text '(set-logic ST)
(declare-const s String)
(declare-const r RegLan)
(declare-const i Int)
(declare-const s1 String)
(declare-const s2 String)
(declare-const s3 String)
(declare-const r1 RegLan)
(declare-const r2 RegLan)
(declare-const n Int)
(assert (= (str.++ s1 s2) s3))
(assert (= (str.len s) i))
(assert (str.< s1 s2))
(assert (= (str.to_re s) r))
(assert (str.in_re s r))
(assert (= re.none r))
(assert (= re.all r))
(assert (= re.allchar r))
(assert (= (re.++ r1 r2) r))
(assert (= (re.union r1 r2) r))
(assert (= (re.inter r1 r2) r))
(assert (= (re.* r1) r))
(assert (str.<= s1 s2))
(assert (= (str.at s i) s1))
(assert (= (str.substr s i n) s1))
(assert (str.prefixof s1 s))
(assert (str.suffixof s1 s))
(assert (str.contains s s1))
(assert (= (str.indexof s s1 i) n))
(assert (= (str.replace s s1 s2) s3))
(assert (= (str.replace_all s s1 s2) s3))
(assert (= (str.replace_re s r1 s1) s2))
(assert (= (str.replace_re_all s r1 s1) s2))
(assert (= (re.comp r1) r))
(assert (= (re.diff r1 r2) r))
(assert (= (re.+ r1) r))
(assert (= (re.opt r1) r))
(assert (= (re.range s1 s2) r))
(assert (= ((_ re.^ 3) r1) r))
(assert (= ((_ re.loop 2 5) r1) r))
(assert (str.is_digit s))
(assert (= (str.to_code s) i))
(assert (= (str.from_code i) s))
(assert (= (str.to_int s) i))
(assert (= (str.from_int i) s))'
