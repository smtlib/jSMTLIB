##EXITCODE 0
# Tests that jsmtlib.properties is loaded correctly from each search location.
#
# Locations exercised:
#   1. Embedded in the jar the code is actually running from (own jar, whatever it's
#      named -- see issue #35) -- the primary case for deployed users
#   2. A jsmtlib.properties file that is a sibling of that same jar
#   3. Current working directory -- user override
#   4. java -jar invocation style -- verifies the jar is self-contained

TMPDIR=$(mktemp -d)
trap 'rm -rf "$TMPDIR"' EXIT

PASS=0
FAIL=0

pass() { echo "PASS: $1"; PASS=$((PASS + 1)); }
fail() { echo "FAIL: $1"; FAIL=$((FAIL + 1)); if [ -n "$2" ]; then echo "  $2"; fi; }

# Minimal SMT-LIB input that exercises set-logic and exit cleanly.
cat > "$TMPDIR/minimal.tst" <<'EOF'
(set-logic QF_UF)
(exit)
EOF

# ---------------------------------------------------------------------------
# Test 1: jar-embedded properties found when running with "java -jar"
# Run from a temp directory that has NO local jsmtlib.properties.
# The verbose message "reading properties (own jar)" confirms the embedded
# copy was loaded, identified via the jar's own code source rather than a
# hardcoded jar filename (see issue #35).
# ---------------------------------------------------------------------------
echo "Test 1: jar-embedded properties (java -jar, no local properties file)"
err=$(cd "$TMPDIR" && java -jar "$SMT_JAR" --verbose 1 --solver test "$TMPDIR/minimal.tst" 2>&1 >/dev/null)
if echo "$err" | grep -q "reading properties (own jar)"; then
    pass "jar-embedded properties loaded via 'java -jar'"
else
    fail "jar-embedded properties NOT loaded via 'java -jar'" "stderr: $err"
fi

# ---------------------------------------------------------------------------
# Test 2: jar-embedded properties found when running with "java -cp jar"
# This is the invocation style used by the test suite (without SMT_DIR).
# ---------------------------------------------------------------------------
echo "Test 2: jar-embedded properties (java -cp jar, no local properties file)"
err=$(cd "$TMPDIR" && java -cp "$SMT_JAR" org.smtlib.SMT --verbose 1 --solver test "$TMPDIR/minimal.tst" 2>&1 >/dev/null)
if echo "$err" | grep -q "reading properties (own jar)"; then
    pass "jar-embedded properties loaded via 'java -cp jar'"
else
    fail "jar-embedded properties NOT loaded via 'java -cp jar'" "stderr: $err"
fi

# ---------------------------------------------------------------------------
# Test 3: a jsmtlib.properties file that is a sibling of the actual jar being
# used (whatever that jar is named) is found and loaded, on top of the
# jar-embedded copy -- isolated in a fresh directory (copying the jar there)
# so this doesn't just observe $SMT_DIR's own build-time jsmtlib.properties.
# ---------------------------------------------------------------------------
echo "Test 3: jar-sibling jsmtlib.properties is loaded"
ISODIR=$(mktemp -d)
cp "$SMT_JAR" "$ISODIR/isolated.jar"
err=$(cd "$TMPDIR" && java -jar "$ISODIR/isolated.jar" --verbose 1 --solver test "$TMPDIR/minimal.tst" 2>&1 >/dev/null)
if echo "$err" | grep -q "reading properties (own jar)" && ! echo "$err" | grep -q "reading properties (jar sibling)"; then
    pass "no jar-sibling properties loaded when none is present"
else
    fail "unexpected jar-sibling behavior with no sibling file present" "stderr: $err"
fi
cp "$SMT_DIR/jsmtlib.properties" "$ISODIR/"
err=$(cd "$TMPDIR" && java -jar "$ISODIR/isolated.jar" --verbose 1 --solver test "$TMPDIR/minimal.tst" 2>&1 >/dev/null)
if echo "$err" | grep -q "reading properties (own jar)"; then
    pass "jar-embedded properties still loaded when a sibling copy also present"
else
    fail "jar-embedded properties NOT loaded when a sibling copy also present" "stderr: $err"
fi
if echo "$err" | grep -q "reading properties (jar sibling)"; then
    pass "jar-sibling jsmtlib.properties loaded (renamed jar: isolated.jar)"
else
    fail "jar-sibling jsmtlib.properties NOT loaded" "stderr: $err"
fi
rm -rf "$ISODIR"

# ---------------------------------------------------------------------------
# Test 4: jsmtlib.properties in the current working directory is loaded
# and applied on top of the jar-embedded copy.
# Both "own jar" and "current dir" messages must appear.
# ---------------------------------------------------------------------------
echo "Test 4: CWD jsmtlib.properties overrides jar-embedded copy"
cp "$SMT_DIR/jsmtlib.properties" "$TMPDIR/"
err=$(cd "$TMPDIR" && java -jar "$SMT_JAR" --verbose 1 --solver test "$TMPDIR/minimal.tst" 2>&1 >/dev/null)
if echo "$err" | grep -q "reading properties (own jar)"; then
    pass "jar-embedded properties still loaded when CWD copy also present"
else
    fail "jar-embedded properties NOT loaded when CWD copy also present" "stderr: $err"
fi
if echo "$err" | grep -q "reading properties (current dir)"; then
    pass "CWD jsmtlib.properties loaded"
else
    fail "CWD jsmtlib.properties NOT loaded" "stderr: $err"
fi
rm "$TMPDIR/jsmtlib.properties"

# ---------------------------------------------------------------------------
# Test 5: Tool exits cleanly with correct output in all invocation styles.
# (Regression: verifies that removing SMT_DIR from the classpath doesn't
# break normal operation.)
# ---------------------------------------------------------------------------
echo "Test 5: correct SMT-LIB output with jar-only classpath"
out=$(cd "$TMPDIR" && java -cp "$SMT_JAR" org.smtlib.SMT --solver test "$TMPDIR/minimal.tst" 2>/dev/null | tr -d '\r')
# set-logic and exit with default print-success=true produce two "success" lines
expected="$(printf 'success\nsuccess')"
if [ "$out" = "$expected" ]; then
    pass "correct output with jar-only classpath"
else
    fail "unexpected output with jar-only classpath" "expected: '$expected'  got: '$out'"
fi

# ---------------------------------------------------------------------------
echo ""
if [ $FAIL -eq 0 ]; then
    echo "All $PASS properties tests PASSED"
    exit 0
else
    echo "$FAIL FAILURES, $PASS passed"
    exit 1
fi
