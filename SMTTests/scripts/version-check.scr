### Checks that the version reported by --version matches SMT/version.txt, the source
### of truth baked into the jar at build time (guards against a stale jar/build).
##EXITCODE 0
VER=$(cat ../SMT/version.txt)
echo $VER
$SMT_CMD --version | diff -b - <(echo "$VER")
$SMT_CMD --solver test $SCRIPTS/version-check.smt2 | diff -b - <(echo "(:version \"$VER\" )")
