(assert (fp.isInfinite (_ +oo 8 24)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (fp.isInfinite (_ -oo 8 24)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (fp.isZero (_ +zero 8 24)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (fp.isNegative (_ -zero 8 24)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (fp.isNaN (_ NaN 8 24)))
