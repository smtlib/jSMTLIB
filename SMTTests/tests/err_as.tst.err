(assert (= ((as + Int) 4 3) 1)) ;; unneeded disambiguation
           ^^^^^^^^^^^^^^^^
(assert (= ((as and Bool) true false) false)) ;; not overloaded
           ^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (= ((as zzz Bool) true false) false)) ;; unknown identifier
           ^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (= ((as + S) 4 3) 1))  ;; not overloaded to S
           ^^^^^^^^^^^^^^
