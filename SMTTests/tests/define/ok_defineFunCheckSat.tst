; define-fun with parameters, used in check-sat; nested definitions (#95)
(set-logic QF_UF)
(declare-sort A 0)
(declare-fun g (A A) A)
(declare-fun a () A)
(declare-fun b () A)
(define-fun f ((x A)(y A)) A (g y x))
(define-fun p ((x A)) Bool (= (f x x) a))
(assert (p b))
(check-sat)
(assert (not (= (g b b) a)))
(check-sat)
