(set-logic QF_LIA)
^^^^^^^^^^^^^^^^^^
(declare-fun x () Int)
^^^^^^^^^^^^^^^^^^^^^^
(assert (> x 0))
^^^^^^^^^^^^^^^^
(set-option :regular-output-channel "stderr")
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(declare-fun y () Int)
^^^^^^^^^^^^^^^^^^^^^^
(check-sat)
^^^^^^^^^^^
(set-option :regular-output-channel "stdout")
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (> y 0))
^^^^^^^^^^^^^^^^
(check-sat)
^^^^^^^^^^^
