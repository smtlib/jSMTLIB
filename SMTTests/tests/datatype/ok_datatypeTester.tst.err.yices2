(declare-datatype Color ((red) (green)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(declare-datatypes ((Lst 1)) ((par (E) ((nil) (cons (hd E) (tl (Lst E)))))))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(declare-fun c () Color)
^^^^^^^^^^^^^^^^^^^^^^^^
(declare-fun l () (Lst Int))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert ((_ is red) c))
^^^^^^^^^^^^^^^^^^^^^^^
(assert (not ((_ is green) c)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert ((_ is cons) l))
^^^^^^^^^^^^^^^^^^^^^^^^
(assert ((_ is nil) (tl l)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^
