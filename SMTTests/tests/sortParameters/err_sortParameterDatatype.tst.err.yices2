(set-info :smt-lib-version 2.7)
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(declare-sort-parameter A)
^^^^^^^^^^^^^^^^^^^^^^^^^^
(declare-datatype D ((mk (f A))))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(declare-datatype L (par (X) ((nil) (cons (hd A) (tl (L X))))))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(declare-datatype M (par (A) ((nil2) (cons2 (hd2 A) (tl2 (M A))))))
