(declare-fun f (A) A)
^^^^^^^^^^^^^^^^^^^^^
(declare-const b Bool)
^^^^^^^^^^^^^^^^^^^^^^
(declare-const n Int)
^^^^^^^^^^^^^^^^^^^^^
(assert (= (f b) (not b)))
^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (= (f n) (+ n 1)))
^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert b)
^^^^^^^^^^
(assert (= n 2))
^^^^^^^^^^^^^^^^
(check-sat)
^^^^^^^^^^^
(get-value ((f b) (f n)))
^^^^^^^^^^^^^^^^^^^^^^^^^
