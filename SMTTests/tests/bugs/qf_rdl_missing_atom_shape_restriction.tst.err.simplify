(assert (<= x 5.0))
              ^^^
(assert (>= (- x y) 3.0))
                    ^^^
(assert (>= (- x y) (- 3.0)))
                       ^^^
(assert (>= (- x 1.0) y))
        ^^^^^^^^^^^^^^^^
(assert (and (>= x y) (>= (- x 1.0) y)))
                      ^^^^^^^^^^^^^^^^
(assert (and (>= (- x y) 3.0) (<= (- y x) 5.0)))
                         ^^^
(assert (>= (* x y) 0.0))
        ^^^^^^^^^^^^^^^^
(assert (forall ((a Real)) (>= a 0.0)))
        ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(declare-fun f (Real) Real)
             ^
(declare-sort S 0)
              ^
