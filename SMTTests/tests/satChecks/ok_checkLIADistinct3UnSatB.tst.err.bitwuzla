(set-logic QF_LIA)
^^^^^^^^^^^^^^^^^^
(declare-fun x () Int)
^^^^^^^^^^^^^^^^^^^^^^
(declare-fun y () Int)
^^^^^^^^^^^^^^^^^^^^^^
(declare-fun z () Int)
^^^^^^^^^^^^^^^^^^^^^^
(declare-fun m () Int)
^^^^^^^^^^^^^^^^^^^^^^
(assert (and (> x 1) (> y x)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (and (> y 1) (> z y)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (and (> z 1) (> m z)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (distinct x y z))
^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (= m 4))
^^^^^^^^^^^^^^^^
(check-sat)
^^^^^^^^^^^
