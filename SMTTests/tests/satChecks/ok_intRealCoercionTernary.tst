; Int arguments to three-argument functions: user-defined Real functions and ite. The correct behavior is
; unclear: the :extensions sugar is stated only for (op Real Real s) and /. jSMTLIB reads them as to_real (#211).
; Each check is unsat if the solver reads an Int argument as Real (to_real); a solver that rejects
; the term reports an error and the check is sat. Int q = 1, r = 2; Real a = 0.5, b = 1.5. See #211.
(set-logic AUFNIRA)
(declare-fun q () Int)
(declare-fun r () Int)
(declare-fun a () Real)
(declare-fun b () Real)
(assert (and (= q 1) (= r 2) (= a 0.5) (= b 1.5)))
(define-fun g ((x Real) (y Real) (z Real)) Real (+ x y z))
(declare-fun k (Real Real Real) Bool)
(assert (k 1.0 2.0 0.5))
(push 1)
(assert (not (= (g a b q) 3.0)))
(check-sat)
(pop 1)
(push 1)
(assert (not (= (g q r a) 3.5)))
(check-sat)
(pop 1)
(push 1)
(assert (not (k q r a)))
(check-sat)
(pop 1)
(push 1)
(assert (not (= (ite true q a) 1.0)))
(check-sat)
(pop 1)
