(set-logic QF_LIA)
^^^^^^^^^^^^^^^^^^
(declare-fun x () Int)
^^^^^^^^^^^^^^^^^^^^^^
(declare-fun y () Int)
^^^^^^^^^^^^^^^^^^^^^^
(declare-fun z () Int)
^^^^^^^^^^^^^^^^^^^^^^
(assert (= x (+ y 1)))
^^^^^^^^^^^^^^^^^^^^^^
(assert (= z (- y 2)))
^^^^^^^^^^^^^^^^^^^^^^
(assert (= x 4))
^^^^^^^^^^^^^^^^
(assert (= z 2))
^^^^^^^^^^^^^^^^
(check-sat)
