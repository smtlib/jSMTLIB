(set-logic AUFNIRA)
^^^^^^^^^^^^^^^^^^^
(declare-fun q () Int)
^^^^^^^^^^^^^^^^^^^^^^
(declare-fun r () Int)
^^^^^^^^^^^^^^^^^^^^^^
(declare-fun a () Real)
^^^^^^^^^^^^^^^^^^^^^^^
(declare-fun b () Real)
^^^^^^^^^^^^^^^^^^^^^^^
(assert (and (= q 1) (= r 2) (= a 0.5) (= b 1.5)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(define-fun f ((x Real) (y Real)) Real (+ x y))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(push 1)
^^^^^^^^
(assert (not (= (+ q a) 1.5)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(check-sat)
^^^^^^^^^^^
(pop 1)
^^^^^^^
(push 1)
^^^^^^^^
(assert (not (= (+ a q) 1.5)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(check-sat)
^^^^^^^^^^^
(pop 1)
^^^^^^^
(push 1)
^^^^^^^^
(assert (not (= (/ r q) 2.0)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(check-sat)
^^^^^^^^^^^
(pop 1)
^^^^^^^
(push 1)
^^^^^^^^
(assert (not (= (f q a) 1.5)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(check-sat)
^^^^^^^^^^^
(pop 1)
^^^^^^^
(push 1)
^^^^^^^^
(assert (not (= (f a q) 1.5)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(check-sat)
^^^^^^^^^^^
(pop 1)
^^^^^^^
