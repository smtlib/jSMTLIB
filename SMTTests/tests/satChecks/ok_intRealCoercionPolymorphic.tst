; Int mixed with Real in Core's polymorphic = and distinct, read as to_real (#211 item 1).
; Each check is unsat if the solver reads an Int argument as Real (to_real); a solver that rejects
; the term reports an error and the check is sat. Int q = 1, r = 2; Real a = 0.5, b = 1.5. See #211.
(set-logic AUFNIRA)
(declare-fun q () Int)
(declare-fun r () Int)
(declare-fun a () Real)
(declare-fun b () Real)
(assert (and (= q 1) (= r 2) (= a 0.5) (= b 1.5)))
(push 1)
(assert (not (= (+ a 0.5) q)))
(check-sat)
(pop 1)
(push 1)
(assert (not (= q (+ a 0.5))))
(check-sat)
(pop 1)
(push 1)
(assert (not (= q (+ a 0.5) (- b 0.5))))
(check-sat)
(pop 1)
(push 1)
(assert (not (= (+ a 0.5) (- b 0.5) q)))
(check-sat)
(pop 1)
(push 1)
(assert (not (distinct q a)))
(check-sat)
(pop 1)
(push 1)
(assert (not (distinct a b r)))
(check-sat)
(pop 1)
