(set-logic QF_UFLIA)
^^^^^^^^^^^^^^^^^^^^
(declare-fun p () Bool)
^^^^^^^^^^^^^^^^^^^^^^^
(declare-fun q () Bool)
^^^^^^^^^^^^^^^^^^^^^^^
(declare-fun g (Bool) Int)
^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (not p))
^^^^^^^^^^^^^^^^
(assert (not q))
^^^^^^^^^^^^^^^^
(assert (not (= (g p) (g q))))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(check-sat)
^^^^^^^^^^^
