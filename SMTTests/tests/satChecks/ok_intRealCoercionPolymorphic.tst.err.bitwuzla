(set-logic AUFNIRA)
^^^^^^^^^^^^^^^^^^^
(declare-fun q () Int)
^^^^^^^^^^^^^^^^^^^^^^
(declare-fun r () Int)
^^^^^^^^^^^^^^^^^^^^^^
(declare-fun a () Real)
^^^^^^^^^^^^^^^^^^^^^^^
(declare-fun b () Real)
^^^^^^^^^^^^^^^^^^^^^^^
(assert (and (= q 1) (= r 2) (= a 0.5) (= b 1.5)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(push 1)
^^^^^^^^
(assert (not (= (+ a 0.5) q)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(check-sat)
^^^^^^^^^^^
(pop 1)
^^^^^^^
(push 1)
^^^^^^^^
(assert (not (= q (+ a 0.5))))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(check-sat)
^^^^^^^^^^^
(pop 1)
^^^^^^^
(push 1)
^^^^^^^^
(assert (not (= q (+ a 0.5) (- b 0.5))))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(check-sat)
^^^^^^^^^^^
(pop 1)
^^^^^^^
(push 1)
^^^^^^^^
(assert (not (= (+ a 0.5) (- b 0.5) q)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(check-sat)
^^^^^^^^^^^
(pop 1)
^^^^^^^
(push 1)
^^^^^^^^
(assert (not (distinct q a)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(check-sat)
^^^^^^^^^^^
(pop 1)
^^^^^^^
(push 1)
^^^^^^^^
(assert (not (distinct a b r)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(check-sat)
^^^^^^^^^^^
(pop 1)
^^^^^^^
