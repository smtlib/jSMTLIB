; Int mixed with Real in n-ary arithmetic and chainable comparisons, the Int not first (#211 item 2).
; Each check is unsat if the solver reads an Int argument as Real (to_real); a solver that rejects
; the term reports an error and the check is sat. Int q = 1, r = 2; Real a = 0.5, b = 1.5. See #211.
(set-logic AUFNIRA)
(declare-fun q () Int)
(declare-fun r () Int)
(declare-fun a () Real)
(declare-fun b () Real)
(assert (and (= q 1) (= r 2) (= a 0.5) (= b 1.5)))
(push 1)
(assert (not (= (+ a b q) 3.0)))
(check-sat)
(pop 1)
(push 1)
(assert (not (= (+ a q b) 3.0)))
(check-sat)
(pop 1)
(push 1)
(assert (not (= (+ q r a) 3.5)))
(check-sat)
(pop 1)
(push 1)
(assert (not (= (* a b q) 0.75)))
(check-sat)
(pop 1)
(push 1)
(assert (not (= (- b a q) 0.0)))
(check-sat)
(pop 1)
(push 1)
(assert (not (< a q b)))
(check-sat)
(pop 1)
(push 1)
(assert (not (<= q b r)))
(check-sat)
(pop 1)
