(set-logic QF_UFLIA)
^^^^^^^^^^^^^^^^^^^^
(declare-fun x () Int)
^^^^^^^^^^^^^^^^^^^^^^
(declare-fun p () Bool)
^^^^^^^^^^^^^^^^^^^^^^^
(declare-fun q () Bool)
^^^^^^^^^^^^^^^^^^^^^^^
(declare-fun g (Bool) Int)
^^^^^^^^^^^^^^^^^^^^^^^^^^
(push 1)
^^^^^^^^
(assert (not (= (g (< x 0)) (g (not (>= x 0))))))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(check-sat)
^^^^^^^^^^^
(pop 1)
^^^^^^^
(push 1)
^^^^^^^^
(assert (not (= (g (xor p q)) (g (distinct p q)))))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(check-sat)
^^^^^^^^^^^
(pop 1)
^^^^^^^
(push 1)
^^^^^^^^
(assert (not (= (g (=> p q)) (g (or (not p) q)))))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(check-sat)
^^^^^^^^^^^
(pop 1)
^^^^^^^
(assert (not (= (g (and p (= x 1) true)) (g (and (= 1 x) p)))))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(check-sat)
^^^^^^^^^^^
