(set-logic QF_UFLIA)
^^^^^^^^^^^^^^^^^^^^
(push 1)
^^^^^^^^
(declare-fun h (Int) Bool)
^^^^^^^^^^^^^^^^^^^^^^^^^^
(pop 1)
^^^^^^^
(declare-fun g (Bool) Int)
^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (not (h 1)))
^^^^^^^^^^^^^^^^^^^^
(assert (not (h 2)))
^^^^^^^^^^^^^^^^^^^^
(assert (not (= (g (h 1)) (g (h 2)))))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(check-sat)
^^^^^^^^^^^
