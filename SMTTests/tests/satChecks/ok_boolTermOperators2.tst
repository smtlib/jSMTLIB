; Bool operators as function arguments, beyond ok_boolTermOperators: <=, >, distinct on terms,
; distinct on three Bools (always false), Bool ite and false. The first check is sat, so
; a translation that made everything unsat fails it; the others have equal truth values, so unsat.
(set-logic QF_UFLIA)
(declare-fun x () Int)
(declare-fun y () Int)
(declare-fun z () Int)
(declare-fun p () Bool)
(declare-fun q () Bool)
(declare-fun r () Bool)
(declare-fun g (Bool) Int)
(push 1)
(assert (not (= (g (<= x 1)) (g (< x 1)))))
(check-sat)
(pop 1)
(push 1)
(assert (not (= (g (<= x 1)) (g (not (> x 1))))))
(check-sat)
(pop 1)
(push 1)
(assert (not (= (g (distinct x y z)) (g (and (distinct x y) (distinct y z) (distinct x z))))))
(check-sat)
(pop 1)
(push 1)
(assert (not (= (g (distinct p q r)) (g false))))
(check-sat)
(pop 1)
(assert (not (= (g (ite p q r)) (g (or (and p q) (and (not p) r))))))
(check-sat)
