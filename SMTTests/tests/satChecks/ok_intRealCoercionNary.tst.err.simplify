(set-logic AUFNIRA)
           ^^^^^^^
(declare-fun q () Int)
^^^^^^^^^^^^^^^^^^^^^^
(declare-fun r () Int)
^^^^^^^^^^^^^^^^^^^^^^
(declare-fun a () Real)
^^^^^^^^^^^^^^^^^^^^^^^
(declare-fun b () Real)
^^^^^^^^^^^^^^^^^^^^^^^
(assert (and (= q 1) (= r 2) (= a 0.5) (= b 1.5)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(push 1)
^^^^^^^^
(assert (not (= (+ a b q) 3.0)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(check-sat)
^^^^^^^^^^^
(pop 1)
^^^^^^^
(push 1)
^^^^^^^^
(assert (not (= (+ a q b) 3.0)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(check-sat)
^^^^^^^^^^^
(pop 1)
^^^^^^^
(push 1)
^^^^^^^^
(assert (not (= (+ q r a) 3.5)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(check-sat)
^^^^^^^^^^^
(pop 1)
^^^^^^^
(push 1)
^^^^^^^^
(assert (not (= (* a b q) 0.75)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(check-sat)
^^^^^^^^^^^
(pop 1)
^^^^^^^
(push 1)
^^^^^^^^
(assert (not (= (- b a q) 0.0)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(check-sat)
^^^^^^^^^^^
(pop 1)
^^^^^^^
(push 1)
^^^^^^^^
(assert (not (< a q b)))
^^^^^^^^^^^^^^^^^^^^^^^^
(check-sat)
^^^^^^^^^^^
(pop 1)
^^^^^^^
(push 1)
^^^^^^^^
(assert (not (<= q b r)))
^^^^^^^^^^^^^^^^^^^^^^^^^
(check-sat)
^^^^^^^^^^^
(pop 1)
^^^^^^^
