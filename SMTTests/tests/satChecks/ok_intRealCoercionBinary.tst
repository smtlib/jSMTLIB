; The cases AUFNIRA's :extensions state: (op t1 t) and (op t t1) for op declared (op Real Real s),
; by a theory or by the user, and (/ t1 t2), with t1, t2 Int and t Real.
; Each check is unsat if the solver reads an Int argument as Real (to_real); a solver that rejects
; the term reports an error and the check is sat. Int q = 1, r = 2; Real a = 0.5, b = 1.5. See #211.
(set-logic AUFNIRA)
(declare-fun q () Int)
(declare-fun r () Int)
(declare-fun a () Real)
(declare-fun b () Real)
(assert (and (= q 1) (= r 2) (= a 0.5) (= b 1.5)))
(define-fun f ((x Real) (y Real)) Real (+ x y))
(push 1)
(assert (not (= (+ q a) 1.5)))
(check-sat)
(pop 1)
(push 1)
(assert (not (= (+ a q) 1.5)))
(check-sat)
(pop 1)
(push 1)
(assert (not (= (/ r q) 2.0)))
(check-sat)
(pop 1)
(push 1)
(assert (not (= (f q a) 1.5)))
(check-sat)
(pop 1)
(push 1)
(assert (not (= (f a q) 1.5)))
(check-sat)
(pop 1)
