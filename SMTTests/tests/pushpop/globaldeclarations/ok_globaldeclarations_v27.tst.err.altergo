(declare-sort-parameter X)
^^^^^^^^^^^^^^^^^^^^^^^^^^
(declare-fun f (X) X)
^^^^^^^^^^^^^^^^^^^^^
(pop 1)
^^^^^^^
(declare-fun x () X)
^^^^^^^^^^^^^^^^^^^^
(assert (and m (= (f x) x)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (and m (= (f (f x)) x)))
