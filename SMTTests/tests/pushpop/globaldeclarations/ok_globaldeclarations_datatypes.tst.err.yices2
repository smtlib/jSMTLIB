(declare-datatype Color ((red) (green)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(declare-datatypes ((Tree 0) (Forest 0)) (((leaf) (node (val Int) (kids Forest))) ((fnil) (fcons (head Tree) (rest Forest)))))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(define-fun-rec size ((t Tree)) Int (match t ((leaf 0) ((node v k) 1))))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(define-funs-rec ((p ((x Int)) Bool) (q ((x Int)) Bool)) ((ite (= x 0) true (q (- x 1))) (ite (= x 0) false (p (- x 1)))))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(declare-fun c () Color)
^^^^^^^^^^^^^^^^^^^^^^^^
(declare-fun r () Tree)
^^^^^^^^^^^^^^^^^^^^^^^
(assert (= c red))
^^^^^^^^^^^^^^^^^^
(assert (match r ((leaf false) ((node v w) (= (val r) v)))))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (p (size r)))
^^^^^^^^^^^^^^^^^^^^^
(reset-assertions)
^^^^^^^^^^^^^^^^^^
(assert (= c green))
^^^^^^^^^^^^^^^^^^^^
(assert (= (kids r) (fcons leaf fnil)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (match r ((leaf false) ((node v w) (= w (rest w))))))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (q (size (head (kids r)))))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
