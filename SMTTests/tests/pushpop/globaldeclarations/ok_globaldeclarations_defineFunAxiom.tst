; A global define-fun keeps its definition after pop and reset-assertions: both check-sats are unsat (#165)
(set-option :global-declarations true)
(set-logic QF_UF)
(declare-sort U 0)
(declare-fun a () U)
(push 1)
(define-fun c () U a)
(pop 1)
(assert (not (= c a)))
(check-sat)
(reset-assertions)
(assert (not (= c a)))
(check-sat)
