; with global declarations, declarations and definitions survive pop and reset-assertions (#166)
(set-option :global-declarations true)
(set-logic ALL)
(push 1)
(declare-const k Int)
(declare-fun f (Int) Int)
(define-fun g ((x Int)) Int (+ x 1))
(declare-sort S 0)
(define-sort T () (Array Int Int))
(pop 1)
(declare-fun s () S)
(declare-fun t () T)
(assert (= (f k) (g (select t k))))
(reset-assertions)
(assert (= (f (g k)) (select t 0)))
(assert (= s s))
