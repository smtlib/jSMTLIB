(set-logic ALL)
           ^^^
(declare-const k Int)
^^^^^^^^^^^^^^^^^^^^^
(declare-fun f (Int) Int)
^^^^^^^^^^^^^^^^^^^^^^^^^
(define-fun g ((x Int)) Int (+ x 1))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(declare-sort S 0)
^^^^^^^^^^^^^^^^^^
(define-sort T () (Array Int Int))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(declare-fun s () S)
^^^^^^^^^^^^^^^^^^^^
(declare-fun t () T)
^^^^^^^^^^^^^^^^^^^^
(assert (= (f k) (g (select t k))))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(declare-const k Bool)
^^^^^^^^^^^^^^^^^^^^^^
(declare-fun f () Bool)
^^^^^^^^^^^^^^^^^^^^^^^
(declare-fun g () Bool)
^^^^^^^^^^^^^^^^^^^^^^^
(declare-sort S 1)
^^^^^^^^^^^^^^^^^^
(define-sort T () Bool)
^^^^^^^^^^^^^^^^^^^^^^^
(declare-fun s () (S Int))
^^^^^^^^^^^^^^^^^^^^^^^^^^
(declare-fun t () T)
^^^^^^^^^^^^^^^^^^^^
(assert (and k f g t (= s s)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(declare-const k Real)
^^^^^^^^^^^^^^^^^^^^^^
(declare-fun f () Real)
^^^^^^^^^^^^^^^^^^^^^^^
(declare-fun g () Real)
^^^^^^^^^^^^^^^^^^^^^^^
(declare-sort S 2)
^^^^^^^^^^^^^^^^^^
(define-sort T () Real)
^^^^^^^^^^^^^^^^^^^^^^^
(declare-fun s () (S Int Int))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(declare-fun t () T)
^^^^^^^^^^^^^^^^^^^^
(assert (= (+ k f g t) 0.0))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^
