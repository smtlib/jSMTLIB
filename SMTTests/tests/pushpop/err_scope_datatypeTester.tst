; a tester goes out of scope with its datatype, and applies only to that datatype (#166, #167)
(set-logic ALL)
(push 1)
(declare-datatype Shape ((circle) (square)))
(declare-fun s () Shape)
(assert ((_ is circle) s))
(pop 1)
(declare-sort Shape 0)
(declare-fun s () Shape)
(assert ((_ is circle) s))
(declare-datatype Color ((red) (green)))
(declare-fun x () Int)
(assert ((_ is red) x))
; Solver bug (.bad golden): smtinterpol-2.5 crashes on (_ is circle) applied after the pop.
