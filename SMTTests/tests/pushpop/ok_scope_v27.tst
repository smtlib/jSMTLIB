; pop and reset-assertions remove the SMT-LIB 2.7 define-const and declare-sort-parameter:
; each name is declared again afterwards (#166)
(set-info :smt-lib-version 2.7)
(set-logic ALL)
(push 1)
(define-const m Bool true)
(declare-sort-parameter X)
(declare-fun f (X) X)
(pop 1)
(declare-const m Int)
(declare-sort X 0)
(declare-fun f (X) Bool)
(reset-assertions)
(define-const m Bool true)
(declare-sort-parameter X)
(declare-fun f (X) X)
(reset-assertions)
(declare-const m Int)
(declare-sort X 0)
(declare-fun f (X) Bool)
(reset-assertions)
(declare-const m Real)
(declare-sort X 1)
(declare-fun f ((X Int)) Bool)
