; pop removes the declarations and definitions made since its push: each name is declared
; again afterwards, which succeeds only if the first one is gone (#166)
(set-logic ALL)
(push 1)
(declare-const k Int)
(declare-fun f (Int) Int)
(define-fun g ((x Int)) Int (+ x 1))
(declare-sort S 0)
(define-sort T () (Array Int Int))
(declare-fun s () S)
(declare-fun t () T)
(assert (= (f k) (g (select t k))))
(pop 1)
(declare-const k Bool)
(declare-fun f () Bool)
(declare-fun g () Bool)
(declare-sort S 1)
(define-sort T () Bool)
(declare-fun s () (S Int))
(declare-fun t () T)
(assert (and k f g t (= s s)))
