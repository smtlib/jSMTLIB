(set-logic ALL)
           ^^^
(push 1)
^^^^^^^^
(declare-datatypes ((Lst 1)) ((par (E) ((nil) (cons (hd E) (tl (Lst E)))))))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(declare-fun l () (Lst Int))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (= (hd l) 1))
^^^^^^^^^^^^^^^^^^^^^
(pop 1)
^^^^^^^
(declare-sort Lst 0)
^^^^^^^^^^^^^^^^^^^^
(declare-fun nil () Int)
^^^^^^^^^^^^^^^^^^^^^^^^
(declare-fun cons () Int)
^^^^^^^^^^^^^^^^^^^^^^^^^
(declare-fun hd () Int)
^^^^^^^^^^^^^^^^^^^^^^^
(declare-fun tl () Int)
^^^^^^^^^^^^^^^^^^^^^^^
