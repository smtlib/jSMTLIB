(define-fun-rec h ((x Int)) Int (ite (<= x 0) 0 (h (- x 1))))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(define-funs-rec ((p ((x Int)) Bool) (q ((x Int)) Bool)) ((ite (= x 0) true (q (- x 1))) (ite (= x 0) false (p (- x 1)))))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (q (h 3)))
^^^^^^^^^^^^^^^^^^
(declare-fun h () Int)
^^^^^^^^^^^^^^^^^^^^^^
(declare-fun p () Int)
^^^^^^^^^^^^^^^^^^^^^^
(declare-fun q () Int)
^^^^^^^^^^^^^^^^^^^^^^
(declare-fun h () Real)
^^^^^^^^^^^^^^^^^^^^^^^
(declare-fun p () Real)
^^^^^^^^^^^^^^^^^^^^^^^
(declare-fun q () Real)
^^^^^^^^^^^^^^^^^^^^^^^
