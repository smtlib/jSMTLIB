; pop and reset-assertions remove define-fun-rec and define-funs-rec definitions: each name
; is declared again afterwards (#166)
(set-logic ALL)
(push 1)
(define-fun-rec h ((x Int)) Int (ite (<= x 0) 0 (h (- x 1))))
(define-funs-rec ((p ((x Int)) Bool) (q ((x Int)) Bool)) ((ite (= x 0) true (q (- x 1))) (ite (= x 0) false (p (- x 1)))))
(assert (p (h 3)))
(pop 1)
(declare-fun h () Bool)
(declare-fun p () Bool)
(declare-fun q () Bool)
(reset-assertions)
(define-fun-rec h ((x Int)) Int (ite (<= x 0) 0 (h (- x 1))))
(define-funs-rec ((p ((x Int)) Bool) (q ((x Int)) Bool)) ((ite (= x 0) true (q (- x 1))) (ite (= x 0) false (p (- x 1)))))
(assert (q (h 3)))
(reset-assertions)
(declare-fun h () Int)
(declare-fun p () Int)
(declare-fun q () Int)
(reset-assertions)
(declare-fun h () Real)
(declare-fun p () Real)
(declare-fun q () Real)
