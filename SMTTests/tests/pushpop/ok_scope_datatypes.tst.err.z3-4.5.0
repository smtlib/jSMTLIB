(declare-datatypes ((Tree 0) (Forest 0)) (((leaf) (node (val Int) (kids Forest))) ((fnil) (fcons (head Tree) (rest Forest)))))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(declare-fun c () Color)
^^^^^^^^^^^^^^^^^^^^^^^^
(declare-fun t () Tree)
^^^^^^^^^^^^^^^^^^^^^^^
(assert (= c red))
^^^^^^^^^^^^^^^^^^
(assert (= (val t) 0))
^^^^^^^^^^^^^^^^^^^^^^
(assert (match t ((leaf false) ((node v k) (= k fnil)))))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(declare-datatypes ((Tree 0) (Forest 0)) (((leaf) (node (val Int) (kids Forest))) ((fnil) (fcons (head Tree) (rest Forest)))))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(declare-fun t () Tree)
^^^^^^^^^^^^^^^^^^^^^^^
(assert (match t ((leaf true) ((node v k) (= (head (fcons t k)) leaf)))))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
