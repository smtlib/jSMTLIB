; define-fun after check-sat returns the solver to assert mode, where get-proof is an error
; (cvc5, z3 4.6 and later and SMTInterpol answer it; their adapters check)
(set-option :produce-proofs true)
(set-logic QF_UF)
(declare-fun p () Bool)
(assert p)
(assert (not p))
(check-sat)
(define-fun r () Bool true)
(get-proof)
