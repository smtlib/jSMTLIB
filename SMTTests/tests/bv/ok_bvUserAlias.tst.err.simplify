(set-logic QF_BV)
           ^^^^^
(define-sort Word32 () (_ BitVec 32))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(declare-fun x () Word32)
^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (= x #x0000000F))
^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (= (bvand x #x000000FF) #x0000000F))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(check-sat)
^^^^^^^^^^^
(assert (= (bvand x #x000000FF) #x00000000))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(check-sat)
^^^^^^^^^^^
