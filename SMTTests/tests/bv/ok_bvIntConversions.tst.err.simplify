(assert (= b #xff))                                    ; unsigned 255, signed -1
           ^
(assert (= n (ubv_to_int b)))
                         ^
(assert (= m (sbv_to_int b)))
                         ^
(assert (= c ((_ int_to_bv 8) 20)))                    ; 20 mod 256 = 20
           ^
(assert (not (and (= n 255) (= m (- 1)) (= c #x14))))
                                           ^
