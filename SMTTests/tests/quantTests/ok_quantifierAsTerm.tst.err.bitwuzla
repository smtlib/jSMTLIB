(set-logic AUFLIA)
^^^^^^^^^^^^^^^^^^
(declare-fun g (Bool) Int)
^^^^^^^^^^^^^^^^^^^^^^^^^^
(push 1)
^^^^^^^^
(assert (not (= (g (forall ((y Int)) (> y 0))) (g false))))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(check-sat)
^^^^^^^^^^^
(pop 1)
^^^^^^^
(assert (not (= (g (exists ((y Int)) (> y 0))) (g true))))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(check-sat)
^^^^^^^^^^^
