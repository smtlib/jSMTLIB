(declare-fun f () (-> Int (-> Int Bool)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(declare-fun x () Int)
^^^^^^^^^^^^^^^^^^^^^^
(declare-fun y () Int)
^^^^^^^^^^^^^^^^^^^^^^
(declare-fun h () (-> Int Bool))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (= (@ f x) h))
^^^^^^^^^^^^^^^^^^^^^^
(assert (@ h y))
^^^^^^^^^^^^^^^^
(check-sat)
^^^^^^^^^^^
(assert (not (@ (@ f x) y)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(check-sat)
^^^^^^^^^^^
