(set-logic UFNIA)
^^^^^^^^^^^^^^^^^
(declare-sort MySort 0)
^^^^^^^^^^^^^^^^^^^^^^^
(declare-const x Int)
^^^^^^^^^^^^^^^^^^^^^
(declare-const y Int)
^^^^^^^^^^^^^^^^^^^^^
(assert (= y (* x x)))
^^^^^^^^^^^^^^^^^^^^^^
(declare-fun f (Int) Int)
^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (= y (f x)))
^^^^^^^^^^^^^^^^^^^^
(assert (forall ((z Int)) (>= (* z z) 0)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (exists ((z Int)) (= (* z z) x)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
