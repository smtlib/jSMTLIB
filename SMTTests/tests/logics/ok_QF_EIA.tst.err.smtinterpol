(declare-const x Int)
^^^^^^^^^^^^^^^^^^^^^
(declare-const y Int)
^^^^^^^^^^^^^^^^^^^^^
(assert (= y (+ x 1)))
^^^^^^^^^^^^^^^^^^^^^^
(assert (= y (- x 1)))
^^^^^^^^^^^^^^^^^^^^^^
(assert (= y (* x x)))
^^^^^^^^^^^^^^^^^^^^^^
(assert (= y (* 3 x)))
^^^^^^^^^^^^^^^^^^^^^^
(assert (>= x 0))
^^^^^^^^^^^^^^^^^
(assert (<= x y))
^^^^^^^^^^^^^^^^^
(assert (= y (- x)))
^^^^^^^^^^^^^^^^^^^^
(assert (distinct x y))
^^^^^^^^^^^^^^^^^^^^^^^
(assert (= y (** x 2)))
^^^^^^^^^^^^^^^^^^^^^^^
(assert (= y (** 2 x)))
^^^^^^^^^^^^^^^^^^^^^^^
(assert (>= (** x 3) 0))
^^^^^^^^^^^^^^^^^^^^^^^^
