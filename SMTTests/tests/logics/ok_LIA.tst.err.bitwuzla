(set-logic LIA)
^^^^^^^^^^^^^^^
(declare-const x Int)
^^^^^^^^^^^^^^^^^^^^^
(declare-const y Int)
^^^^^^^^^^^^^^^^^^^^^
(assert (= y (+ x 1)))
^^^^^^^^^^^^^^^^^^^^^^
(assert (= y (- x 1)))
^^^^^^^^^^^^^^^^^^^^^^
(assert (= y (* 3 x)))
^^^^^^^^^^^^^^^^^^^^^^
(assert (= y (* x 3)))
^^^^^^^^^^^^^^^^^^^^^^
(assert (>= x 0))
^^^^^^^^^^^^^^^^^
(assert (forall ((z Int)) (>= z 0)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (exists ((z Int)) (= z x)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(define-sort MyInt () Int)
^^^^^^^^^^^^^^^^^^^^^^^^^^
