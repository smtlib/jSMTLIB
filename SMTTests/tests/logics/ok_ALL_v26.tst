; Under SMT-LIB 2.6, ALL provides every 2.6 theory: Ints, Reals, BitVec, Array, FloatingPoint, Strings
(set-info :smt-lib-version 2.6)
(set-logic ALL)
(declare-fun i () Int)
(declare-fun r () Real)
(declare-fun a () (Array Int Int))
(declare-fun b () (_ BitVec 8))
(declare-fun f () Float32)
(declare-fun s () String)
(assert (= (to_real (+ i 1)) r))
(assert (= (select a i) 3))
(assert (= (bvadd b #x01) #x02))
(assert (fp.isNormal f))
(assert (= (str.len (str.++ s "a")) i))
