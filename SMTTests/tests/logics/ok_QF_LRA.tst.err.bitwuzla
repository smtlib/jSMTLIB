(set-logic QF_LRA)
^^^^^^^^^^^^^^^^^^
(declare-const x Real)
^^^^^^^^^^^^^^^^^^^^^^
(declare-const y Real)
^^^^^^^^^^^^^^^^^^^^^^
(assert (= y (+ x 1.0)))
^^^^^^^^^^^^^^^^^^^^^^^^
(assert (= y (* 3.0 x)))
^^^^^^^^^^^^^^^^^^^^^^^^
(assert (>= x 0.0))
^^^^^^^^^^^^^^^^^^^
(define-fun scale ((r Real)) Real (* 2.0 r))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(define-sort MyReal () Real)
^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (= y (/ 1.0 2.0)))
^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (= y (* (- 3.0) x)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (= y (* (+ x 1.0) 2.0)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
