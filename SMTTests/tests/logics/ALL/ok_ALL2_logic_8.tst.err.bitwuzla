(declare-fun n () Int )
^^^^^^^^^^^^^^^^^^^^^^^
(assert (= n  (ubv_to_int b)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(declare-fun nn () Int  )
^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (= nn (ubv_to_int bb)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (bvult b #xf0))
^^^^^^^^^^^^^^^^^^^^^^^
(assert (not (and (>= nn n) (>= (+ n 15) nn) (= (mod nn 16) 0) )))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(check-sat)  ; result should be unsat
^^^^^^^^^^^
