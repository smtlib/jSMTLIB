(set-logic QF_LIA)
^^^^^^^^^^^^^^^^^^
(declare-const x Int)
^^^^^^^^^^^^^^^^^^^^^
(declare-const y Int)
^^^^^^^^^^^^^^^^^^^^^
(assert (= y (+ x 1)))
^^^^^^^^^^^^^^^^^^^^^^
(assert (= y (* 3 x)))
^^^^^^^^^^^^^^^^^^^^^^
(assert (>= x 0))
^^^^^^^^^^^^^^^^^
(define-fun double ((n Int)) Int (* 2 n))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(define-sort MyInt () Int)
