(set-logic QF_LIA)
^^^^^^^^^^^^^^^^^^
(declare-const x Int)
^^^^^^^^^^^^^^^^^^^^^
(push 1)
^^^^^^^^
(assert ((_ divisible 3) x))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (= x 7))
^^^^^^^^^^^^^^^^
(check-sat)
^^^^^^^^^^^
(pop 1)
^^^^^^^
(assert ((_ divisible 3) x))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (< 7 x 10))
^^^^^^^^^^^^^^^^^^^
(check-sat)
^^^^^^^^^^^
