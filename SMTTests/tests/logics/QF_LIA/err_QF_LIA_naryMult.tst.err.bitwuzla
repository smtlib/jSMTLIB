(set-logic QF_LIA)
^^^^^^^^^^^^^^^^^^
(declare-const x Int)
^^^^^^^^^^^^^^^^^^^^^
(declare-const y Int)
^^^^^^^^^^^^^^^^^^^^^
(assert (= y (* x y 2)))
^^^^^^^^^^^^^^^^^^^^^^^^
(assert (= y (* 2 x y)))
^^^^^^^^^^^^^^^^^^^^^^^^
(assert (= y (* 2 x 3)))
^^^^^^^^^^^^^^^^^^^^^^^^
(assert (= y (* 2 x)))
^^^^^^^^^^^^^^^^^^^^^^
