(set-logic QF_UFLIA)
^^^^^^^^^^^^^^^^^^^^
(declare-const x Int)
^^^^^^^^^^^^^^^^^^^^^
(declare-const y Int)
^^^^^^^^^^^^^^^^^^^^^
(declare-fun f (Int) Int)
^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (= y (+ x 1)))
^^^^^^^^^^^^^^^^^^^^^^
(assert (= y (* 3 x)))
^^^^^^^^^^^^^^^^^^^^^^
(assert (= y (f x)))
^^^^^^^^^^^^^^^^^^^^
