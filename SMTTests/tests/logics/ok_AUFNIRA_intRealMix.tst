; AUFNIRA's :extensions: (op t1 t) and (op t t1), with t1 Int, t Real and op of rank
; (op Real Real s), mean (op (to_real t1) t) and (op t (to_real t1)); the n-ary forms of
; :left-assoc and :chainable operators reduce to binary ones (Sec. 3.6.2)
(set-logic AUFNIRA)
(declare-const i Int)
(declare-const r Real)
(declare-fun g (Real Real) Bool)
(assert (g i r))
(assert (g r i))
(assert (= r i))
(assert (distinct i r))
(assert (= (+ i r i) (* r i)))
(assert (< i r i))
(assert (= (- r i) (/ r i)))
(reset)
(set-logic AUFLIRA)
(declare-const i Int)
(declare-const r Real)
(assert (<= (+ i r) (- r i)))
