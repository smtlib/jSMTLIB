(set-logic QF_NRA)
^^^^^^^^^^^^^^^^^^
(declare-const a Real)
^^^^^^^^^^^^^^^^^^^^^^
(declare-const b Real)
^^^^^^^^^^^^^^^^^^^^^^
(assert (= b (* a a)))
^^^^^^^^^^^^^^^^^^^^^^
(assert (>= (* a b) 0.0))
^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (= b (+ (* a a) 1.0)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(define-sort MyReal () Real)
^^^^^^^^^^^^^^^^^^^^^^^^^^^^
