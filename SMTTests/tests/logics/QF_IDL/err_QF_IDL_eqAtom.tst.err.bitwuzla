(set-logic QF_IDL)
^^^^^^^^^^^^^^^^^^
(declare-const x Int)
^^^^^^^^^^^^^^^^^^^^^
(declare-const y Int)
^^^^^^^^^^^^^^^^^^^^^
(declare-const p Bool)
^^^^^^^^^^^^^^^^^^^^^^
(assert (= x (* 3 y)))
^^^^^^^^^^^^^^^^^^^^^^
(assert (= (+ x y) 7))
^^^^^^^^^^^^^^^^^^^^^^
(assert (distinct x 3))
^^^^^^^^^^^^^^^^^^^^^^^
(assert (< x (ite p y x)))
^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (= x y y))
^^^^^^^^^^^^^^^^^^
