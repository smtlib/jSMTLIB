(set-logic AUFLIRA)
^^^^^^^^^^^^^^^^^^^
(declare-const a Real)
^^^^^^^^^^^^^^^^^^^^^^
(declare-const b Real)
^^^^^^^^^^^^^^^^^^^^^^
(assert (= b (* 2.0 a)))
^^^^^^^^^^^^^^^^^^^^^^^^
(assert (= b (* a 2.0)))
^^^^^^^^^^^^^^^^^^^^^^^^
(assert (= b (+ a 1.0)))
^^^^^^^^^^^^^^^^^^^^^^^^
(assert (>= a 0.0))
^^^^^^^^^^^^^^^^^^^
(assert (= b (/ 2.0 3.0)))
^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (= b (* (- 2.0) a)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(define-sort MyArr () (Array Int Real))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(define-sort MyArr2 () (Array Int (Array Int Real)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
