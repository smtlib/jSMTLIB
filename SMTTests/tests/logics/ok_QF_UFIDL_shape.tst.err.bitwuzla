(set-logic QF_UFIDL)
^^^^^^^^^^^^^^^^^^^^
(declare-const x Int)
^^^^^^^^^^^^^^^^^^^^^
(declare-const y Int)
^^^^^^^^^^^^^^^^^^^^^
(declare-fun f (Int) Int)
^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (= (+ x 1) y))
^^^^^^^^^^^^^^^^^^^^^^
(assert (< (- 2 x) (f y)))
^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (= (- 0 5) (+ 1 x 2)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (<= x y (f x)))
^^^^^^^^^^^^^^^^^^^^^^^
(assert (= (f (+ 3 x)) (- (f x) 1)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
