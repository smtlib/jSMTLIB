(set-logic QF_UFIDL)
^^^^^^^^^^^^^^^^^^^^
(declare-const x Int)
^^^^^^^^^^^^^^^^^^^^^
(declare-const y Int)
^^^^^^^^^^^^^^^^^^^^^
(declare-fun f (Int) Int)
^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (= (+ x y) 3))
^^^^^^^^^^^^^^^^^^^^^^
(assert (< (- x (f y)) 0))
^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (= (f (- x y)) 0))
^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (= (+ x 1 y) 0))
^^^^^^^^^^^^^^^^^^^^^^^^
(assert (= (* 2 x) y))
^^^^^^^^^^^^^^^^^^^^^^
(assert (= (- x) y))
^^^^^^^^^^^^^^^^^^^^
(assert (= (div x 2) y))
^^^^^^^^^^^^^^^^^^^^^^^^
(assert (= (mod x 2) y))
^^^^^^^^^^^^^^^^^^^^^^^^
(assert (= (abs x) y))
^^^^^^^^^^^^^^^^^^^^^^
