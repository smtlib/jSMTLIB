(set-logic UFLRA)
^^^^^^^^^^^^^^^^^
(declare-sort MySort 0)
^^^^^^^^^^^^^^^^^^^^^^^
(declare-const a Real)
^^^^^^^^^^^^^^^^^^^^^^
(declare-const b Real)
^^^^^^^^^^^^^^^^^^^^^^
(assert (= b (+ a 1.0)))
^^^^^^^^^^^^^^^^^^^^^^^^
(assert (= b (- a 1.0)))
^^^^^^^^^^^^^^^^^^^^^^^^
(assert (= b (* 2.0 a)))
^^^^^^^^^^^^^^^^^^^^^^^^
(declare-fun f (Real) Real)
^^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (= b (f a)))
^^^^^^^^^^^^^^^^^^^^
(assert (forall ((z Real)) (>= z 0.0)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (exists ((z Real)) (= z a)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
