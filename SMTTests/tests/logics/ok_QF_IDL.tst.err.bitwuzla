(set-logic QF_IDL)
^^^^^^^^^^^^^^^^^^
(declare-const x Int)
^^^^^^^^^^^^^^^^^^^^^
(declare-const y Int)
^^^^^^^^^^^^^^^^^^^^^
(assert (>= x y))
^^^^^^^^^^^^^^^^^
(assert (<= x y))
^^^^^^^^^^^^^^^^^
(assert (> x y))
^^^^^^^^^^^^^^^^
(assert (< x y))
^^^^^^^^^^^^^^^^
(assert (>= (- x y) 3))
^^^^^^^^^^^^^^^^^^^^^^^
(assert (<= (- x y) 3))
^^^^^^^^^^^^^^^^^^^^^^^
(assert (> (- x y) 0))
^^^^^^^^^^^^^^^^^^^^^^
(assert (< (- x y) 0))
^^^^^^^^^^^^^^^^^^^^^^
(assert (>= (- x y) 0))
^^^^^^^^^^^^^^^^^^^^^^^
(assert (>= (- x y) (- 3)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (<= (- x y) (- 5)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (> (- x y) (- 1)))
^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (< (- x y) (- 7)))
^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (and (>= (- x y) 3) (<= (- y x) 5)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (or (>= x y) (>= y x)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (not (> x y)))
^^^^^^^^^^^^^^^^^^^^^^
(define-sort MyInt () Int)
^^^^^^^^^^^^^^^^^^^^^^^^^^
