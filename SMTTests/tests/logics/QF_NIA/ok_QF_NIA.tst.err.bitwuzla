(set-logic QF_NIA)
^^^^^^^^^^^^^^^^^^
(declare-const x Int)
^^^^^^^^^^^^^^^^^^^^^
(declare-const y Int)
^^^^^^^^^^^^^^^^^^^^^
(assert (= y (* x x)))
^^^^^^^^^^^^^^^^^^^^^^
(assert (= y (* x y)))
^^^^^^^^^^^^^^^^^^^^^^
(assert (>= (* x x) 0))
^^^^^^^^^^^^^^^^^^^^^^^
(define-sort MyInt () Int)
