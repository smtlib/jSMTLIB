(set-logic QF_RDL)
           ^^^^^^
(declare-const x Real)
^^^^^^^^^^^^^^^^^^^^^^
(declare-const y Real)
^^^^^^^^^^^^^^^^^^^^^^
(assert (< (- x y) (/ 3 2)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (>= (- y x) (/ (- 7) 4)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (> (- y x) (- 2)))
^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (> (- (+ x x) (+ y y)) 2))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(check-sat)
^^^^^^^^^^^
