(set-logic QF_RDL)
^^^^^^^^^^^^^^^^^^
(declare-const x Real)
^^^^^^^^^^^^^^^^^^^^^^
(declare-const y Real)
^^^^^^^^^^^^^^^^^^^^^^
(declare-const p Bool)
^^^^^^^^^^^^^^^^^^^^^^
(assert (ite p (< x y) (< y x)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (xor p (< x y)))
^^^^^^^^^^^^^^^^^^^^^^^^
(assert (= p (> x y)))
^^^^^^^^^^^^^^^^^^^^^^
(assert (= x y))
^^^^^^^^^^^^^^^^
(assert (distinct (- x y) (- 3)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (<= (- x y) (/ 1 3)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (<= (- x y) (/ (- 1) 3)))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (<= (- (+ x x x) (+ y y y)) 1))
^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
