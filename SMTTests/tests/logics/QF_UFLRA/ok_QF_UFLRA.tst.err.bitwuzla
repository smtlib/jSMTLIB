(set-logic QF_UFLRA)
^^^^^^^^^^^^^^^^^^^^
(declare-sort MySort 0)
^^^^^^^^^^^^^^^^^^^^^^^
(declare-const a Real)
^^^^^^^^^^^^^^^^^^^^^^
(declare-const b Real)
^^^^^^^^^^^^^^^^^^^^^^
(declare-fun f (Real) Real)
^^^^^^^^^^^^^^^^^^^^^^^^^^^
(assert (= b (+ a 1.0)))
^^^^^^^^^^^^^^^^^^^^^^^^
(assert (= b (- a 1.0)))
^^^^^^^^^^^^^^^^^^^^^^^^
(assert (= b (* 2.0 a)))
^^^^^^^^^^^^^^^^^^^^^^^^
(assert (= b (* a 2.0)))
^^^^^^^^^^^^^^^^^^^^^^^^
(assert (>= a 0.0))
^^^^^^^^^^^^^^^^^^^
(assert (= b (f a)))
^^^^^^^^^^^^^^^^^^^^
