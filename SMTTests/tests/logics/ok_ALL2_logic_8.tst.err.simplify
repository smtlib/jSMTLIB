(define-fun bb () (_ BitVec 8) (bvneg (bvand (bvneg b) #xf0))) ; rounds up to multiple of 16
            ^^
(assert (= n  (ubv_to_int b)))
                          ^
(assert (= nn (ubv_to_int bb)))
                          ^^
(assert (bvult b #xf0))
               ^
(assert (not (and (>= nn n) (>= (+ n 15) nn) (= (mod nn 16) 0) )))
                                                ^^^^^^^^^^^
