; words reserved only from SMT-LIB 2.5 on are ordinary symbols in 2.0
(set-info :smt-lib-version 2.0)
(set-logic QF_UF)
(declare-fun BINARY () Bool)
(declare-fun HEXADECIMAL () Bool)
(declare-fun check-sat-assuming () Bool)
(declare-fun declare-const () Bool)
(declare-fun define-fun-rec () Bool)
(declare-fun define-funs-rec () Bool)
(declare-fun echo () Bool)
(declare-fun get-model () Bool)
(declare-fun get-unsat-assumptions () Bool)
(declare-fun reset () Bool)
(declare-fun reset-assertions () Bool)
