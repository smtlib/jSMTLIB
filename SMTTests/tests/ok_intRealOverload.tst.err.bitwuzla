(set-logic AUFNIRA)
^^^^^^^^^^^^^^^^^^^
(declare-fun q () Int)
^^^^^^^^^^^^^^^^^^^^^^
(declare-fun r () Int)
^^^^^^^^^^^^^^^^^^^^^^
(declare-fun a () Real)
^^^^^^^^^^^^^^^^^^^^^^^
(declare-fun b () Real)
^^^^^^^^^^^^^^^^^^^^^^^
(assert (>= a b))
^^^^^^^^^^^^^^^^^
(assert (>= q r))
^^^^^^^^^^^^^^^^^
(assert (<= a b))
^^^^^^^^^^^^^^^^^
(assert (<= q r))
^^^^^^^^^^^^^^^^^
(assert (> a b))
^^^^^^^^^^^^^^^^
(assert (> q r))
^^^^^^^^^^^^^^^^
(assert (< a b))
^^^^^^^^^^^^^^^^
(assert (< q r))
^^^^^^^^^^^^^^^^
