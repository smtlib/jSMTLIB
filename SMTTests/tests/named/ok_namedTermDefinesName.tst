; a named term defines its name for later assertions; each check-sat but the last is unsat
(set-option :print-success false)
(set-logic QF_UF)
(declare-sort U 0)
(declare-fun p () Bool)
(declare-fun q () Bool)
(declare-fun a () U)
(declare-fun b () U)
(declare-fun g (U) U)
(declare-fun f (Bool) U)
(push 1)
(assert (! (and p q) :named PQ))
(assert (not PQ))
(check-sat)
(pop 1)
(push 1)
(assert (= (! (g a) :named GA) b))
(assert (not (= GA b)))
(check-sat)
(pop 1)
(push 1)
(assert (= (f (! (and p q) :named T)) a))
(assert (and p q (not T)))
(check-sat)
(pop 1)
(push 1)
(assert (! q :named |Q x|))
(assert (not |Q x|))
(check-sat)
(pop 1)
(assert (! p :named P))
(assert P)
(check-sat)
