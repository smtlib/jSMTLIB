; define-fun after check-sat returns the solver to assert mode, where get-unsat-core is an error
; (cvc5, z3 4.6 and later, yices2 and SMTInterpol answer it; their adapters check)
(set-option :produce-unsat-cores true)
(set-logic QF_UF)
(declare-fun p () Bool)
(assert (! p :named a))
(assert (! (not p) :named b))
(check-sat)
(define-fun r () Bool true)
(get-unsat-core)
