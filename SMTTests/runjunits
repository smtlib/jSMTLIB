#!/bin/bash
## Run standalone JUnit unit tests (those that need no external solver).
## When COV is set (to any value, including empty), attaches the JaCoCo agent
## and writes coverage to cov/junits.exec.

cd "$(dirname "$0")" || exit 1
trap 'exit 130' INT
# setup-coverage must be sourced BEFORE setup so that COV_AGENT is already set
# when setup constructs SMT_CMD / SMT_DRIVER.  That way any JVM processes spawned
# by ScriptTests (via $SMT_CMD) are also instrumented.
if [ -n "${COV++}" ]; then
    source ./setup-coverage junits
fi
source setup

echo "Solvers: ${SMT_TEST_SOLVERS:-test}"

JUNIT_JAR="lsp/libs/junit-4.13.2.jar"
HAMCREST_JAR="lsp/libs/hamcrest-core-1.3.jar"
# setup already set SMT_JAR to an absolute path; use COV_CLASSES only when coverage is on.
# Do NOT fall back to a relative path here — scripts that cd to a temp dir depend on SMT_JAR
# being absolute when they inherit it from the environment.
SMT_JAR="${COV_CLASSES:-$SMT_JAR}"
TEST_BIN="bin"

# Windows Java requires ; as classpath separator and Windows-style paths.
_p=$(uname -s | tr '[:upper:]' '[:lower:]')
if [[ "$_p" == mingw* || "$_p" == msys* || "$_p" == cygwin* ]]; then
    _w() { cygpath -w "$1"; }
    CP="$(_w "$SMT_JAR");$(_w "$JUNIT_JAR");$(_w "$HAMCREST_JAR");$(_w "$TEST_BIN")"
else
    CP="${SMT_JAR}:${JUNIT_JAR}:${HAMCREST_JAR}:${TEST_BIN}"
fi

## Copy .smt2 resource files so they are on the classpath at runtime.
mkdir -p "${TEST_BIN}/org/smtlib/test"
cp src/org/smtlib/test/*.smt2 "${TEST_BIN}/org/smtlib/test/" 2>/dev/null || true

## Discover test sources dynamically so a newly-added file is never silently
## left out of either the compile or the run list. Every source under
## src/org/smtlib/test is compiled; a source is added to the JUnitCore run
## list only if it contains at least one @Test annotation itself (base/helper
## classes like LogicTests, LogicsBase, TypeCheckRoot, JUnitListener have none
## and are compiled-only, matched by their subclasses' own @Test methods).
TEST_SOURCES=()
for f in src/org/smtlib/test/*.java; do
    TEST_SOURCES+=("$f")
done

TEST_CLASSES=()
for f in "${TEST_SOURCES[@]}"; do
    if grep -q '@Test' "$f"; then
        TEST_CLASSES+=("org.smtlib.test.$(basename "$f" .java)")
    fi
done

## Compile any unit-test sources that are newer than their .class files.
echo "Compiling unit tests..."
javac -cp "$CP" -d "$TEST_BIN" \
    src/org/junit/runners/ParameterizedWithNames.java \
    "${TEST_SOURCES[@]}"
ret=$?
if [ $ret -ne 0 ]; then
    echo "Compilation FAILED"
    exit $ret
fi

## Run unit tests under the JaCoCo agent (COV_AGENT is empty when coverage is off).
## RunAll is a thin wrapper around JUnitCore that additionally logs progress and
## failures to a timestamped file as they happen (see LoggingRunListener) -- the
## stock `java org.junit.runner.JUnitCore <classes>` CLI only prints a summary at
## the very end, which isn't useful for watching a long multi-solver run live
## (e.g. `tail -f junit-logs/junit-<timestamp>.log`).
echo "Running unit tests..."
java ${COV_AGENT:-} -cp "$CP" org.smtlib.test.RunAll junit-logs "${TEST_CLASSES[@]}"
ret=$?
[ $ret -eq 0 ] && echo "Unit tests SUCCEEDED" || echo "Unit tests FAILED"
exit $ret
