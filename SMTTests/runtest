#!/bin/bash

## Note: Files ending in .tst are test scripts
##       Files ending in .tst.out are the corresponding expected outputs
##       Files ending in .tst.out.<solver>.actual are the actual stdout if the test fails
##       Files ending in .tst.err are the expected err output if non-empty
##       Files ending in .tst.err.<solver>.actual are the actual stderr if the test fails
##       Files ending in .tst.skip.<solver> or .tst.skip skip this test (content is the reason)
##       The solver name is embedded in the .actual filename (not just .tst.out.actual) so that
##       distinct solvers tested against the same .tst file never share -- and clobber -- one
##       another's capture file.
##       Goldens and skip markers are looked up by solver name: exact name, then family, then
##       plain. A bare name such as cvc5 counts first as the versioned name it runs (cvc5-1.3.2),
##       with itself as the family; see "resolved" below. For each name N (exact, then family) the
##       goldens are N.<platform-arch>.bad/.lenient, N.<platform-arch>, N.<platform>.bad/.lenient,
##       N.<platform>, N, N.bad/.lenient; then the plain .<platform-arch>, .<platform>, none.

if [ $# -lt 2 ]; then
    echo "Usage: runtest <solver> <testfile>"
    exit 1
fi
solver=$1
test=$2

### A "family" fallback lets several versions of the same solver (e.g. z3-4.8.12,
### z3-4.10.2) share one golden file instead of duplicating identical content per
### exact version: strip a trailing "-N..." or "_N..." version suffix (e.g.
### "z3-4.8.12" -> "z3", "z3-4.3" -> "z3", "cvc5-1.3.2" -> "cvc5"). Solver names with
### no such suffix (e.g. "yices2", "test") are left alone -- family is only used when
### it differs from the exact solver name.
family=$(echo "$solver" | sed -E 's/[_-][0-9].*//')
if [ "$family" == "$solver" ]; then family=""; fi
### A bare solver name runs as the versioned name its configured executable gives
### (.exec.$PLATFORM, then .exec, in SMT/jsmtlib.properties) when that executable is the
### name plus a version suffix: "cvc5" -> "cvc5-1.3.2", "z3" -> "z3-4.16.0", "yices2" ->
### "yices2-2.7.0" (yices2-2.6.5 on Windows). Skip markers and goldens named for that
### versioned name are checked first, then the bare name's own, then the plain ones:
### versioned (exact) -> bare name (family) -> plain. A bare name whose executable has
### another stem (simplify -> Simplify-1.5.4, altergo -> alt-ergo-2.6.3) or that has no
### configured executable keeps only its own files.
### IMPORTANT: this must stay in sync with FileTests.resolvedName.
resolved=""
if [ -z "$family" ]; then
    _prop() { awk -v k="org.smtlib.solver_$solver.$1" 'index($0, k "=") == 1 { v = substr($0, length(k) + 2) } END { print v }' "$SMT_DIR/jsmtlib.properties" | tr -d '\r'; }
    _exec=$(_prop "exec.$PLATFORM")
    if [ -z "$_exec" ]; then _exec=$(_prop exec); fi
    if [ -n "$_exec" ] && [ "$(echo "$_exec" | sed -E 's/[_-][0-9].*//')" == "$solver" ] && [ "$_exec" != "$solver" ]; then
        resolved=$_exec
    fi
fi
if [ ! -e "$test" ] && [ -e "$test.tst" ]; then
    test="$test.tst"
fi
if [ ! -e "$test" ]; then
    echo "ERROR: test file not found: $test"
    exit 1
fi
### --testing scrubs timings and memory figures from get-info responses, as FileTests does
SMT_EXE="$SMT_CMD --solver $solver --testing"

### A leading "; OPTIONS: <flags>" line adds command-line flags after --solver, as FileTests
### does (see FileTests.optionsDirectiveArgs): each is double-quoted, single-quoted (passed
### without the quotes) or unquoted. SMT_TEST_OPTIONS (flags for the whole run, e.g. --pipeline)
### goes first, as in FileTests, so a file's own flags win.
opts=( $SMT_TEST_OPTIONS )
first=$(head -1 "$test" | tr -d '\r')
if [[ "$first" == "; OPTIONS:"* ]]; then
    rest=${first#"; OPTIONS:"}
    re='^[[:space:]]*("([^"]*)"|'"'"'([^'"'"']*)'"'"'|([^[:space:]]+))'
    while [[ $rest =~ $re ]]; do
        opts+=("${BASH_REMATCH[2]}${BASH_REMATCH[3]}${BASH_REMATCH[4]}")
        rest=${rest:${#BASH_REMATCH[0]}}
    done
fi
### Verbose output differs by runner (FileTests has read the properties and passes --text),
### so such a test is FileTests' alone
for o in ${opts[@]+"${opts[@]}"}; do
    if [ "$o" = "--verbose" ] || [ "$o" = "-v" ]; then
        echo "SKIP $solver $test: --verbose output is checked by FileTests only"
        exit 77
    fi
done

### Portable per-test timeout (exit 124 = timed out)
### On Windows the system 'timeout' has incompatible syntax; use the bash fallback there.
TEST_TIMEOUT=${TEST_TIMEOUT:-30}
if [[ "$PLATFORM" != "windows" ]] && command -v timeout &>/dev/null; then
    _timeout() { timeout "$1" "${@:2}"; }
elif [[ "$PLATFORM" != "windows" ]] && command -v gtimeout &>/dev/null; then
    _timeout() { gtimeout "$1" "${@:2}"; }
else
    _timeout() {
        local secs=$1; shift
        "$@" &
        local pid=$! wdpid
        ( sleep "$secs"; kill -TERM "$pid" 2>/dev/null; sleep 2; kill -KILL "$pid" 2>/dev/null ) &
        wdpid=$!
        wait "$pid"; local st=$?
        kill "$wdpid" 2>/dev/null; wait "$wdpid" 2>/dev/null
        return $st
    }
fi

### A test with a .stub file runs only under FileTests, which sets up the stub solver (#145)
if [ -e "${test}.stub" ]; then
    echo "SKIP $solver $test: a .stub test runs only under FileTests"
    exit 77
fi

### Check for skip marker (exit 77 = skipped, not a failure)
if [ -n "$resolved" ] && [ -e "${test}.skip.$resolved.$PLATFORM_ARCH" ]; then
    echo "SKIP $solver $test: $(cat "${test}.skip.$resolved.$PLATFORM_ARCH")"
    exit 77
elif [ -n "$resolved" ] && [ -e "${test}.skip.$resolved.$PLATFORM" ]; then
    echo "SKIP $solver $test: $(cat "${test}.skip.$resolved.$PLATFORM")"
    exit 77
elif [ -n "$resolved" ] && [ -e "${test}.skip.$resolved" ]; then
    echo "SKIP $solver $test: $(cat "${test}.skip.$resolved")"
    exit 77
elif [ -e "${test}.skip.$solver.$PLATFORM_ARCH" ]; then
    echo "SKIP $solver $test: $(cat "${test}.skip.$solver.$PLATFORM_ARCH")"
    exit 77
elif [ -e "${test}.skip.$solver.$PLATFORM" ]; then
    echo "SKIP $solver $test: $(cat "${test}.skip.$solver.$PLATFORM")"
    exit 77
elif [ -e "${test}.skip.$solver" ]; then
    echo "SKIP $solver $test: $(cat "${test}.skip.$solver")"
    exit 77
elif [ -n "$family" ] && [ -e "${test}.skip.$family.$PLATFORM_ARCH" ]; then
    echo "SKIP $solver $test: $(cat "${test}.skip.$family.$PLATFORM_ARCH")"
    exit 77
elif [ -n "$family" ] && [ -e "${test}.skip.$family.$PLATFORM" ]; then
    echo "SKIP $solver $test: $(cat "${test}.skip.$family.$PLATFORM")"
    exit 77
elif [ -n "$family" ] && [ -e "${test}.skip.$family" ]; then
    echo "SKIP $solver $test: $(cat "${test}.skip.$family")"
    exit 77
elif [ -e "${test}.skip.$PLATFORM_ARCH" ]; then
    echo "SKIP $solver $test: $(cat "${test}.skip.$PLATFORM_ARCH")"
    exit 77
elif [ -e "${test}.skip.$PLATFORM" ]; then
    echo "SKIP $solver $test: $(cat "${test}.skip.$PLATFORM")"
    exit 77
elif [ -e "${test}.skip" ]; then
    echo "SKIP $solver $test: $(cat "${test}.skip")"
    exit 77
fi

outactual="${test}.out.${solver}.actual"
erractual="${test}.err.${solver}.actual"
rm -f "$outactual" "$erractual"
echo Running $solver "	" $test

_timeout "$TEST_TIMEOUT" $SMT_EXE ${opts[@]+"${opts[@]}"} "$test" > "$outactual" 2> "$erractual"
_exit=$?
if [ $_exit -eq 124 ]; then
    echo "TIMEOUT (${TEST_TIMEOUT}s) $solver $test"
    exit 1
fi

### Strip Windows CR so Unix golden files match
if [[ "$PLATFORM" == "windows" ]]; then
    tr -d '\r' < "$outactual" > "$outactual.tmp" && mv "$outactual.tmp" "$outactual"
    tr -d '\r' < "$erractual" > "$erractual.tmp" && mv "$erractual.tmp" "$erractual"
fi

### A command sent to a solver that has exited once got an "Error writing to solver" response
### naming an exception that depended on timing, so both sides drop such lines before an
### exact comparison, as FileTests.filterIOExceptionLines does (#150). Such a command now
### answers "The solver process has exited", which is compared.
_filtered() { grep -v -e 'java.io.IOException:' -e 'SolverProcess\$NoResponseException:' "$1"; }

### The goldens named for one solver name, given "<test>.<ext>.<name>", in priority order
_solver_candidates() { echo "$1.$PLATFORM_ARCH.bad" "$1.$PLATFORM_ARCH.lenient" "$1.$PLATFORM_ARCH" "$1.$PLATFORM.bad" "$1.$PLATFORM.lenient" "$1.$PLATFORM" "$1" "$1.bad" "$1.lenient"; }

### Check the error output
### IMPORTANT: the priority order in these two 'for f in' loops must stay in sync
### with the candidates array in FileTests.java (SMTTests/src/org/smtlib/test/FileTests.java).
### If you change the order here, change it there too, and vice versa.
err_candidates=()
if [ -n "$resolved" ]; then err_candidates+=($(_solver_candidates "${test}.err.$resolved")); fi
err_candidates+=($(_solver_candidates "${test}.err.$solver"))
if [ -n "$family" ]; then err_candidates+=($(_solver_candidates "${test}.err.$family")); fi
err_candidates+=("${test}.err.$PLATFORM_ARCH" "${test}.err.$PLATFORM" "${test}.err")

errok=0
while true; do ## The while true is just to allow a break from the inner test loop
    for f in "${err_candidates[@]}"; do
      if [ -e "$f" ]; then
        diff <(_filtered "$erractual") <(_filtered "$f")
        errok=$?
        if [ $errok == 0 ]; then
          rm -f "$erractual"
        else
          echo FAILURE - mismatched error output "$f"
          echo "=== ACTUAL STDERR ===" $solver $PLATFORM_ARCH $PLATFORM $comparison
          if [ -s "$erractual" ]; then
              cat "$erractual"
          else
              echo "Actual error output is empty"
          fi
          echo "=== END ACTUAL STDERR ==="
        fi
        break 2;
      fi
    done
    ## None of the named output files (for error output) exist
    ## That is OK if there is no error output
    if [ -s "$erractual" ]; then
      errok=1
      echo "No expected output for error output"
      cat "$erractual"
    else
      rm -rf "$erractual"
    fi
    break
done
        

### Check the regular output
out_candidates=()
if [ -n "$resolved" ]; then out_candidates+=($(_solver_candidates "${test}.out.$resolved")); fi
out_candidates+=($(_solver_candidates "${test}.out.$solver"))
if [ -n "$family" ]; then out_candidates+=($(_solver_candidates "${test}.out.$family")); fi
out_candidates+=("${test}.out.$PLATFORM_ARCH" "${test}.out.$PLATFORM" "${test}.out")

comparison=""
while true; do ## The while true is just to allow a break from the inner test loop
    for f in "${out_candidates[@]}"; do
      if [ -e "$f" ]; then
        diff <(_filtered "$outactual") <(_filtered "$f")
        diffresult=$?
        comparison="$f"
        break 2
      fi
    done
    echo "No expected output for regular output"
    diffresult=1

    #echo No output file, creating one
    #mv "$outactual" "${test}.out"
    break
done

if [ $diffresult != 0 ] ; then
    echo FAILURE - mismatched regular output $comparison
    echo "=== ACTUAL STDOUT ===" $solver $PLATFORM_ARCH $PLATFORM
    cat "$outactual"
    echo "=== END ACTUAL STDOUT ==="
    exit 1
else
	rm -rf "$outactual"
fi
exit $errok
