#!/bin/bash

## Note: Files ending in .tst are test scripts
##       Files ending in .tst.out are the corresponding expected outputs
##       Files ending in .tst.out.actual are the actual stdout if the test fails
##       Files ending in .tst.err are the expected err output if non-empty
##       Files ending in .tst.err.actual are the actual stderr if the test fails
##       Files ending in .tst.skip.<solver> or .tst.skip skip this test (content is the reason)

if [ $# -lt 2 ]; then
    echo "Usage: runtest <solver> <testfile>"
    exit 1
fi
solver=$1
test=$2
if [ ! -e "$test" ] && [ -e "$test.tst" ]; then
    test="$test.tst"
fi
if [ ! -e "$test" ]; then
    echo "ERROR: test file not found: $test"
    exit 1
fi
SMT_EXE="$SMT_CMD --solver $solver"

### Portable per-test timeout (exit 124 = timed out)
### On Windows the system 'timeout' has incompatible syntax; use the bash fallback there.
TEST_TIMEOUT=${TEST_TIMEOUT:-30}
if [[ "$PLATFORM" != "windows" ]] && command -v timeout &>/dev/null; then
    _timeout() { timeout "$1" "${@:2}"; }
elif [[ "$PLATFORM" != "windows" ]] && command -v gtimeout &>/dev/null; then
    _timeout() { gtimeout "$1" "${@:2}"; }
else
    _timeout() {
        local secs=$1; shift
        "$@" &
        local pid=$! wdpid
        ( sleep "$secs"; kill -TERM "$pid" 2>/dev/null; sleep 2; kill -KILL "$pid" 2>/dev/null ) &
        wdpid=$!
        wait "$pid"; local st=$?
        kill "$wdpid" 2>/dev/null; wait "$wdpid" 2>/dev/null
        return $st
    }
fi

### Check for skip marker (exit 77 = skipped, not a failure)
if [ -e "${test}.skip.$solver.$PLATFORM_ARCH" ]; then
    echo "SKIP $solver $test: $(cat "${test}.skip.$solver.$PLATFORM_ARCH")"
    exit 77
elif [ -e "${test}.skip.$solver.$PLATFORM" ]; then
    echo "SKIP $solver $test: $(cat "${test}.skip.$solver.$PLATFORM")"
    exit 77
elif [ -e "${test}.skip.$solver" ]; then
    echo "SKIP $solver $test: $(cat "${test}.skip.$solver")"
    exit 77
elif [ -e "${test}.skip.$PLATFORM_ARCH" ]; then
    echo "SKIP $solver $test: $(cat "${test}.skip.$PLATFORM_ARCH")"
    exit 77
elif [ -e "${test}.skip.$PLATFORM" ]; then
    echo "SKIP $solver $test: $(cat "${test}.skip.$PLATFORM")"
    exit 77
elif [ -e "${test}.skip" ]; then
    echo "SKIP $solver $test: $(cat "${test}.skip")"
    exit 77
fi

rm -f "${test}.out.actual" "${test}.err.actual"
echo Running $solver "	" $test

_timeout "$TEST_TIMEOUT" $SMT_EXE "$test" > "${test}.out.actual" 2> "${test}.err.actual"
_exit=$?
if [ $_exit -eq 124 ]; then
    echo "TIMEOUT (${TEST_TIMEOUT}s) $solver $test"
    exit 1
fi

### Strip Windows CR so Unix golden files match
if [[ "$PLATFORM" == "windows" ]]; then
    tr -d '\r' < "${test}.out.actual" > "${test}.out.actual.tmp" && mv "${test}.out.actual.tmp" "${test}.out.actual"
    tr -d '\r' < "${test}.err.actual" > "${test}.err.actual.tmp" && mv "${test}.err.actual.tmp" "${test}.err.actual"
fi

### Check the error output
### IMPORTANT: the priority order in these two 'for f in' loops must stay in sync
### with the candidates array in FileTests.java (SMTTests/src/org/smtlib/test/FileTests.java).
### If you change the order here, change it there too, and vice versa.
errok=0
while true; do ## The while true is just to allow a break from the inner test loop
    for f in "${test}.err.$solver.$PLATFORM_ARCH" "${test}.err.$solver.$PLATFORM" "${test}.err.$solver" "${test}.err.$PLATFORM_ARCH" "${test}.err.$PLATFORM" "${test}.err" ; do
      if [ -e "$f" ]; then
        diff "${test}.err.actual" "$f"
        errok=$?
        if [ $errok == 0 ]; then
          rm -f "${test}.err.actual"
        else
          echo FAILURE - mismatched error output "$f"
          echo "=== ACTUAL STDERR ===" $solver $PLATFORM_ARCH $PLATFORM $comparison
          if [ -s "${test}.err.actual" ]; then
              cat "${test}.err.actual"
          else 
              echo "Actual error output is empty"
          fi
          echo "=== END ACTUAL STDERR ==="
        fi
        break 2;
      fi
    done
    ## None of the named output files (for error output) exist
    ## That is OK if there is no error output
    if [ -s "${test}.err.actual" ]; then
      errok=1
      echo "No expected output for error output"
      cat "${test}.err.actual"
    else
      rm -rf "${test}.err.actual"
    fi
    break
done
        

### Check the regular output
comparison=""
while true; do ## The while true is just to allow a break from the inner test loop
    for f in "${test}.out.$solver.$PLATFORM_ARCH" "${test}.out.$solver.$PLATFORM" "${test}.out.$solver" "${test}.out.$solver.bad" "${test}.out.$PLATFORM_ARCH" "${test}.out.$PLATFORM" "${test}.out" ; do
      if [ -e "$f" ]; then
        diff -b -I '[(]:memory' "${test}.out.actual" "$f"
        diffresult=$?
        comparison="$f"
        break 2
      fi
    done
    echo "No expected output for regular output"
    diffresult=1
    
    #echo No output file, creating one
    #mv "${test}.out.actual" "${test}.out"
    break
done

if [ $diffresult != 0 ] ; then
    echo FAILURE - mismatched regular output $comparison
    echo "=== ACTUAL STDOUT ===" $solver $PLATFORM_ARCH $PLATFORM
    cat "${test}.out.actual"
    echo "=== END ACTUAL STDOUT ==="
    exit 1
else
	rm -rf "${test}.out.actual"
fi
exit $errok
