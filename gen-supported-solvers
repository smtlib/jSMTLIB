#!/usr/bin/env python3
"""Generate the "Supported SMT solvers" table from a checkout of the Solvers repo.

Writes two files, both fully generated -- edit this script, not them:

  tex/supported-solvers.tex   a bare LaTeX tabular, \input by the "Supported SMT
                              solvers" appendix of tex/SMTLIBTutorial.tex
  supported-solvers.md        the same table plus the appendix's prose, published
                              at https://smtlib.github.io/jSMTLIB/ and linked
                              from index.html

Usage:  ./gen-supported-solvers [path-to-Solvers-repo]

The path may also come from $SOLVERS_DIR; otherwise a few usual locations are
tried. The repo itself is https://github.com/SMTLIB/Solvers.
"""

import os
import re
import sys

# The five platform directories, in column order, with the headings they get.
PLATFORMS = [
    ("Solvers-linux",       "Linux x86-64"),
    ("Solvers-linux-arm64", "Linux arm64"),
    ("Solvers-macos",       "macOS x86-64"),
    ("Solvers-macos-arm64", "macOS arm64"),
    ("Solvers-windows",     "Windows"),
]

# A solver file is <name>-<version>, optionally suffixed .exe (Windows) or .jar
# (smtinterpol, which is platform-independent Java). Requiring the version to
# start with a digit is what keeps the Windows runtime files out -- libz3.dll,
# Microsoft.Z3.dll, msvcp100.dll, vcomp100.dll and friends have no -<digit>
# version part, so they are excluded without needing to be listed here.
ENTRY = re.compile(r"^(?P<name>.+?)-(?P<version>\d[0-9.]*)(?P<suffix>\.exe|\.jar)?$")

CANDIDATES = [
    "../OpenJML21/Solvers",
    "../Solvers",
    "../../Solvers",
]


def find_solvers_dir(argv):
    """Locate the Solvers checkout: argument, then $SOLVERS_DIR, then guesses."""
    if len(argv) > 1:
        cand = [argv[1]]
    elif os.environ.get("SOLVERS_DIR"):
        cand = [os.environ["SOLVERS_DIR"]]
    else:
        cand = CANDIDATES
    for c in cand:
        p = os.path.abspath(os.path.join(os.path.dirname(os.path.abspath(__file__)), c)) \
            if not os.path.isabs(c) else c
        if os.path.isdir(os.path.join(p, PLATFORMS[0][0])):
            return p
    sys.exit("error: no Solvers checkout found (tried: %s).\n"
             "Pass its path as an argument or set $SOLVERS_DIR." % ", ".join(cand))


def version_key(v):
    """Numeric comparison, so 4.10.2 sorts above 4.3.1 rather than below it."""
    return tuple(int(x) for x in v.split(".") if x.isdigit())


def scan(root):
    """-> {(name, version): set(platform-dir)} over all five platforms."""
    found = {}
    for pdir, _ in PLATFORMS:
        d = os.path.join(root, pdir)
        if not os.path.isdir(d):
            sys.exit("error: missing platform directory %s" % d)
        for entry in os.listdir(d):
            m = ENTRY.match(entry)
            if not m:
                continue                      # runtime libraries, READMEs, etc.
            key = (m.group("name"), m.group("version"))
            found.setdefault(key, set()).add(pdir)
    if not found:
        sys.exit("error: no solver executables recognised under %s" % root)
    return found


def order(found):
    """Alphabetical by solver name; versions ascending, except z3 newest first."""
    def key(item):
        name, version = item
        z3 = name.lower() == "z3"
        vk = version_key(version)
        if z3:
            # Negate each component to sort descending within the same name.
            vk = tuple(-n for n in vk)
        return (name.lower(), vk)
    return sorted(found, key=key)


def cells(found, key):
    return [key in found and pdir in found[key] for pdir, _ in PLATFORMS]


def write_tex(path, found, rows, solvers_dir):
    n = len(PLATFORMS)
    out = []
    out.append("%% Generated by ./gen-supported-solvers -- do not edit by hand.")
    out.append("%% Regenerate after the Solvers repository changes.")
    out.append("")
    # [!ht] plus \small and a slightly tightened \arraystretch keep the table on the
    # same page as the appendix's introductory paragraph. At normal size it needs
    # about 355pt (table 291pt + caption + float separation) but only ~330pt remains
    # under the chapter heading and that paragraph, so it would float to a page of
    # its own; \small with \arraystretch 0.9 brings it to ~307pt. The "!" tells LaTeX
    # to ignore its usual \textfraction/\topfraction limits for this float. Both the
    # table and its caption are inside the group, so the caption is set \small too.
    out.append("\\begin{table}[!ht]")
    out.append("\\centering")
    out.append("\\small")
    out.append("\\renewcommand{\\arraystretch}{0.9}")
    out.append("\\begin{tabular}{|l|" + "c|" * n + "}")
    out.append("\\hline")
    out.append("{\\bf Solver} & " +
               " & ".join("{\\bf %s}" % h.replace("-", "--") for _, h in PLATFORMS) +
               " \\\\")
    out.append("\\hline")
    for key in rows:
        name, version = key
        label = "%s-%s" % (name, version)
        marks = ["$\\bullet$" if c else "" for c in cells(found, key)]
        out.append("{\\tt %s} & " % label.replace("_", "\\_") +
                   " & ".join(marks) + " \\\\")
    out.append("\\hline")
    out.append("\\end{tabular}")
    out.append("\\caption{SMT solvers supplied by the Solvers repository, by platform. "
               "A bullet marks the platforms for which that solver version is provided. "
               "{\\tt smtinterpol} is a Java archive and so runs on every platform.}")
    out.append("\\label{tab:supported-solvers}")
    out.append("\\end{table}")
    out.append("")
    with open(path, "w") as f:
        f.write("\n".join(out))
    return len(rows)


def write_md(path, found, rows):
    out = []
    out.append("# Supported SMT solvers")
    out.append("")
    out.append("There are a variety of SMT solvers. In fact there is an annual competition")
    out.append("([SMT-COMP](https://smt-comp.github.io)) to evaluate the capabilities and")
    out.append("performance of publicly available solvers. The jSMTLIB tool works with the")
    out.append("solvers contained in the [SMTLIB/Solvers](https://github.com/SMTLIB/Solvers)")
    out.append("GitHub repository. The supported solvers are listed here by platform (as of")
    out.append("this writing). There are more solvers than listed here or supported by this")
    out.append("tool. Note that solvers have varying capabilities, from specific to certain")
    out.append("logics to very general.")
    out.append("")
    out.append("`smtinterpol` is a Java archive and so runs on every platform. The Windows")
    out.append("builds are supplied as `.exe` files.")
    out.append("")
    out.append("| Solver | " + " | ".join(h for _, h in PLATFORMS) + " |")
    out.append("|:---|" + ":---:|" * len(PLATFORMS))
    for key in rows:
        name, version = key
        marks = ["✓" if c else "" for c in cells(found, key)]
        out.append("| `%s-%s` | " % (name, version) + " | ".join(marks) + " |")
    out.append("")
    out.append("*This table is generated from the contents of the Solvers repository;")
    out.append("see `gen-supported-solvers` in the gh-pages branch.*")
    out.append("")
    with open(path, "w") as f:
        f.write("\n".join(out))


def main():
    here = os.path.dirname(os.path.abspath(__file__))
    solvers_dir = find_solvers_dir(sys.argv)
    found = scan(solvers_dir)
    rows = order(found)

    tex = os.path.join(here, "tex", "supported-solvers.tex")
    md = os.path.join(here, "supported-solvers.md")
    write_tex(tex, found, rows, solvers_dir)
    write_md(md, found, rows)

    print("Solvers repo: %s" % solvers_dir)
    print("%d solver versions across %d platforms" % (len(rows), len(PLATFORMS)))
    print("wrote %s" % tex)
    print("wrote %s" % md)


if __name__ == "__main__":
    main()
